<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Recovered because IncidentWorker_IonStorm resolves this by name. -->
  <WeatherDef>
    <defName>IonStormWeather</defName>
    <label>Ion Storm</label>
    <description>An ion storm is passing over the map.</description>
    <durationRange>12000~160000</durationRange>
    <repeatable>true</repeatable>
    <favorability>VeryBad</favorability>
    <temperatureRange>-60~60</temperatureRange>
    <rainRate>0.3</rainRate>
    <windSpeedFactor>3</windSpeedFactor>
    <moveSpeedMultiplier>0.5</moveSpeedMultiplier>
    <accuracyMultiplier>0.2</accuracyMultiplier>
    <ambientSounds>
      <li>AmbientRain</li>
      <li>AmbientWind_Storm</li>
    </ambientSounds>
    <skyColorsDay>
      <sky>(0,204,204)</sky>
      <shadow>(0.95,0.95,0.95)</shadow>
      <overlay>(0.7,0.7,0.7)</overlay>
      <saturation>0.8</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0,102,102)</sky>
      <shadow>(0.99,0.99,0.99)</shadow>
      <overlay>(0.8,0.8,0.8)</overlay>
      <saturation>0.8</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0,204,204)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>0.7</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0,204,204)</sky>
      <shadow>(0.9,0.9,0.9)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>0.5</saturation>
    </skyColorsNightMid>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <eventMakers>
      <li>
        <averageInterval>90</averageInterval>
        <eventClass>TiberiumRim.WeatherEvent_IonStrike</eventClass>
      </li>
    </eventMakers>
  </WeatherDef>
</Defs>
