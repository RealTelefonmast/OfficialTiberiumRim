<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    TBI PawnKind evidence promoted to the active MechanicalPawnKindDef
    contract. The donor's race values omitted the Scrin_ prefix even though
    the TBI ThingDefs carry it; these references are normalized to the active
    race defNames below.
  -->

  <PawnKindDef Class="TiberiumRim.MechanicalPawnKindDef">
    <defName>Scrin_Mechapede_TBI</defName>
    <label>mechapede</label>
    <race>Scrin_Mechapede_TBI</race>
    <combatPower>450</combatPower>
    <defaultFactionType>Scrin</defaultFactionType>
    <aiAvoidCover>true</aiAvoidCover>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Map/Things/Pawns/Mechanical/Scrin/Mechapede/Mechapede</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.5</drawSize>
          <shadowData><volume>(0.8, 0.8, 0.8)</volume></shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney><min>5000</min><max>5000</max></weaponMoney>
    <weaponTags><li>MechapedeGun</li></weaponTags>
    <techHediffsMoney><min>2000</min><max>2000</max></techHediffsMoney>
    <techHediffsTags><li>MechInfuse</li></techHediffsTags>
    <techHediffsChance>1</techHediffsChance>
    <inventoryOptions>
      <skipChance>0.5</skipChance>
      <thingDef>TRBattleChip</thingDef>
      <countRange><min>1</min><max>5</max></countRange>
    </inventoryOptions>
  </PawnKindDef>

