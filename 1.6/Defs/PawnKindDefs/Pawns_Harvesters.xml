<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TiberiumRim.HarvesterKindDef>
    <defName>Harvester_Common</defName>
    <label>harvester</label>
    <combatPower>125</combatPower>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <isFighter>false</isFighter>
    <aiAvoidCover>false</aiAvoidCover>
    <race>Harvester_Common</race>
    <wreckDef>HarvesterHusk_Common</wreckDef>
    <acceptedTypes>
      <li>Green</li>
      <li>Blue</li>
      <li>Red</li>
      <li>Sludge</li>
    </acceptedTypes>
    <maxStorage>125</maxStorage>
    <harvestValue>0.125</harvestValue>
    <unloadValue>0.125</unloadValue>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Map/Things/Pawns/Mechanical/Common/Harvester/HarvesterBase</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.4, 0.8, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </TiberiumRim.HarvesterKindDef>
  <TiberiumRim.HarvesterKindDef>
    <defName>Harvester_GDI</defName>
    <label>GDI harvester</label>
    <combatPower>125</combatPower>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <isFighter>false</isFighter>
    <aiAvoidCover>false</aiAvoidCover>
    <race>Harvester_GDI</race>
    <wreckDef>HarvesterHusk_GDI</wreckDef>
    <acceptedTypes>
      <li>Green</li>
      <li>Blue</li>
      <li>Red</li>
      <li>Sludge</li>
    </acceptedTypes>
    <maxStorage>300</maxStorage>
    <harvestValue>0.125</harvestValue>
    <unloadValue>0.125</unloadValue>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <!-- Art gap: GDI files are named {rotation}_Variant01, which
               Graphic_Multi cannot consume; Graphic_Single stand-in until the
               art is renamed to Harvester_Variant01_{rotation}. -->
          <texPath>Map/Things/Pawns/Mechanical/GDI/Harvester/GDI_Harvester_Base</texPath>
          <graphicClass>Verse.Graphic_Multi</graphicClass>
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.4, 0.8, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </TiberiumRim.HarvesterKindDef>
  <TiberiumRim.HarvesterKindDef>
    <defName>Harvester_Nod</defName>
    <label>Nod harvester</label>
    <combatPower>125</combatPower>
    <defaultFactionType>PlayerColony</defaultFactionType>
    <isFighter>false</isFighter>
    <aiAvoidCover>false</aiAvoidCover>
    <race>Harvester_Nod</race>
    <wreckDef>HarvesterHusk_Nod</wreckDef>
    <acceptedTypes>
      <li>Green</li>
      <li>Blue</li>
      <li>Red</li>
      <li>Sludge</li>
    </acceptedTypes>
    <maxStorage>300</maxStorage>
    <harvestValue>0.125</harvestValue>
    <unloadValue>0.125</unloadValue>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <!-- Art gap: Nod files cover east/north/south only; Graphic_Multi
               falls back to a flipped east for the missing west rotation. -->
          <texPath>Map/Things/Pawns/Mechanical/Nod/Harvester/Nod_Harvester_Base</texPath>
          <graphicClass>Verse.Graphic_Multi</graphicClass>
          <drawSize>3</drawSize>
          <shadowData>
            <volume>(0.4, 0.8, 0.4)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </TiberiumRim.HarvesterKindDef>
</Defs>