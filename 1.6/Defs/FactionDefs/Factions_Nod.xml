	<FactionDef ParentName="NodFactionBase">
		<defName>Nod</defName>
		<label>Brotherhood of Nod</label>
		<description>The Brotherhood of Nod is a secretive paramilitary faith built around Kane, Tiberium, and the promise of human ascension. Its cells mix militants, zealots, weapons dealers and elite Black Hand troops into a force that fights from the shadows until it is ready to reveal the temple beneath.</description>
	</FactionDef>

	<ThingSetMakerDef>
		<defName>NodRaidLootMaker</defName>
		<root Class="ThingSetMaker_MarketValue">
			<fixedParams>
				<filter>
					<thingDefs>
						<li>Silver</li>
						<li>MedicineIndustrial</li>
						<li>ComponentIndustrial</li>
						<li>MealSurvivalPack</li>
						<li>Neutroamine</li>
						<li>Chemfuel</li>
						<li>Gun_NodRifle</li>
						<li>Gun_NodTwinTiberiumFlechetteGun</li>
						<li>Gun_NodRocketLauncher</li>
						<li>Weapon_NodGrenade</li>
					</thingDefs>
				</filter>
			</fixedParams>
		</root>
	</ThingSetMakerDef>

