<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionDef ParentName="FactionBase" Name="GDIFactionBase" Abstract="True">
		<pawnSingular>GDI trooper</pawnSingular>
		<pawnsPlural>GDI troopers</pawnsPlural>
		<categoryTag>GDI</categoryTag>
		<listOrderPriority>11</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<startingCountAtWorldCreation>1</startingCountAtWorldCreation>
		<configurationListOrderPriority>64</configurationListOrderPriority>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>general</leaderTitle>
		<leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
		<fixedLeaderKinds><li>GDI_General</li></fixedLeaderKinds>
		<factionIconPath>UI/FactionIcons/GDI</factionIconPath>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<techLevel>Spacer</techLevel>
		<factionNameMaker>NamerFactionGDI</factionNameMaker>
		<settlementNameMaker>NamerSettlementGDI</settlementNameMaker>
		<allowedCultures><li>Astropolitan</li><li>Rustican</li></allowedCultures>
		<backstoryFilters><li><categories><li>Outlander</li></categories><commonality>0.55</commonality></li><li><categories><li>Offworld</li></categories><commonality>0.45</commonality></li></backstoryFilters>
		<allowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Individualist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
		</allowedMemes>
		<structureMemeWeights>
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
		</structureMemeWeights>
		<apparelStuffFilter><stuffCategoriesToAllow><li>Metallic</li><li>Fabric</li></stuffCategoriesToAllow><disallowedThingDefs><li>Jade</li><li>Gold</li></disallowedThingDefs></apparelStuffFilter>
		<allowedArrivalTemperatureRange>-60~60</allowedArrivalTemperatureRange>
		<caravanTraderKinds><li>Caravan_GDI_Supply</li><li>Caravan_GDI_CombatSupplier</li></caravanTraderKinds>
		<visitorTraderKinds><li>Visitor_GDI_Standard</li></visitorTraderKinds>
		<baseTraderKinds><li>Base_GDI_Standard</li></baseTraderKinds>
		<orbitalTraderKinds><li>Orbital_GDI_CommandShip</li></orbitalTraderKinds>
		<raidLootMaker>GDIRaidLootMaker</raidLootMaker>
		<maxPawnCostPerTotalPointsCurve><points><li>(0, 50)</li><li>(70, 80)</li><li>(700, 160)</li><li>(1300, 220)</li><li>(2600, 320)</li><li>(100000, 10000)</li></points></maxPawnCostPerTotalPointsCurve>
		<raidCommonalityFromPointsCurve><points><li>(250, 0)</li><li>(700, 1)</li><li>(1400, 1.6)</li><li>(2800, 2.1)</li><li>(4000, 2.5)</li></points></raidCommonalityFromPointsCurve>
		<pawnGroupMakers>
			<li><kindDef>Combat</kindDef><commonality>100</commonality><options><GDI_Citizen>8</GDI_Citizen><GDI_Engineer>3</GDI_Engineer><GDI_Soldier>18</GDI_Soldier><GDI_Officer>5</GDI_Officer><GDI_SiegeTrooper>3</GDI_SiegeTrooper><GDI_ZoneTrooper>1.5</GDI_ZoneTrooper></options></li>
			<li><kindDef>Combat</kindDef><commonality>40</commonality><options><GDI_Soldier>12</GDI_Soldier><GDI_SiegeTrooper>5</GDI_SiegeTrooper><GDI_Officer>2</GDI_Officer></options></li>
			<li><kindDef>Combat</kindDef><commonality>12</commonality><options><GDI_ZoneTrooper>10</GDI_ZoneTrooper><GDI_Officer>2</GDI_Officer><GDI_General>0.5</GDI_General></options></li>
			<li><kindDef>Peaceful</kindDef><options><GDI_Citizen>18</GDI_Citizen><GDI_Engineer>6</GDI_Engineer><GDI_Soldier>8</GDI_Soldier><GDI_Officer>1</GDI_Officer></options></li>
			<li><kindDef>Trader</kindDef><traders><GDI_Trader>1</GDI_Trader></traders><carriers><Muffalo>5</Muffalo><Dromedary>4</Dromedary><Alpaca>2</Alpaca></carriers><guards><GDI_Soldier>10</GDI_Soldier><GDI_Officer>3</GDI_Officer><GDI_ZoneTrooper>1</GDI_ZoneTrooper></guards></li>
			<li><kindDef>Settlement</kindDef><options><GDI_Citizen>12</GDI_Citizen><GDI_Engineer>5</GDI_Engineer><GDI_Soldier>20</GDI_Soldier><GDI_Officer>5</GDI_Officer><GDI_SiegeTrooper>4</GDI_SiegeTrooper><GDI_ZoneTrooper>3</GDI_ZoneTrooper><GDI_General>0.5</GDI_General></options></li>
		</pawnGroupMakers>
		<disallowedRaidAgeRestrictions><li MayRequire="Ludeon.RimWorld.Biotech">Children</li></disallowedRaidAgeRestrictions>
		<dialogFactionGreetingHostile>GDI command has your location. Keep this brief.</dialogFactionGreetingHostile>
		<dialogFactionGreetingWary>You are speaking to the Global Defense Initiative. State your purpose.</dialogFactionGreetingWary>
		<dialogFactionGreetingWarm>GDI stands with stable settlements. What do you need?</dialogFactionGreetingWarm>
		<dialogMilitaryAidSent>GDI is deploying a response team. Hold your position.</dialogMilitaryAidSent>
	</FactionDef>

	<FactionDef ParentName="GDIFactionBase"><defName>GDI</defName><label>Global Defense Initiative</label><description>The Global Defense Initiative is a professional military coalition built to defend civilian populations from Tiberium disasters, rogue states, alien incursions and the Brotherhood of Nod. Its doctrine favors disciplined infantry, heavy fire support, engineers and elite Zone Troopers.</description></FactionDef>

	<ThingSetMakerDef><defName>GDIRaidLootMaker</defName><root Class="ThingSetMaker_MarketValue"><fixedParams><filter><thingDefs><li>Silver</li><li>MedicineIndustrial</li><li>ComponentIndustrial</li><li>MealSurvivalPack</li><li>Neutroamine</li><li>Chemfuel</li><li>Gun_GDIRifle</li><li>Gun_GDIDiscThrower</li><li>Gun_GDIMobileMortar</li></thingDefs></filter></fixedParams></root></ThingSetMakerDef>

</Defs>
