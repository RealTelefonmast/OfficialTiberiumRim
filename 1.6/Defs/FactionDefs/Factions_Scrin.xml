<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Scrin faction evidence from Factions_Scrin (3).xml. The donor is a
    single hidden faction; the abstract split below follows the active GDI,
    Nod, and Forgotten convention without changing the public defName Scrin.
    Mechapede's six centipede ring parts are external vanilla Core defs; they
    are not expected to appear in the DefMapper historical-mod index.
  -->
  <FactionDef ParentName="FactionBase" Name="ScrinFactionBase" Abstract="True">
    <pawnSingular>scrin unit</pawnSingular>
    <pawnsPlural>scrin units</pawnsPlural>
    <categoryTag>Scrin</categoryTag>
    <listOrderPriority>14</listOrderPriority>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>67</configurationListOrderPriority>
    <factionIconPath>UI/Icons/Factions/Scrin</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultFactionBase</settlementTexturePath>
    <techLevel>Ultra</techLevel>
    <hidden>true</hidden>
    <humanlikeFaction>false</humanlikeFaction>
    <naturalEnemy>true</naturalEnemy>
    <permanentEnemy>true</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <earliestRaidDays>60</earliestRaidDays>
    <!-- startingGoodwill and naturalColonyGoodwill are historical fields;
         RimWorld 1.6 FactionDef rejects them. permanentEnemy already supplies
         the intended hostile relationship, so the redundant mustStartOneEnemy
         flag is not promoted either. -->
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0, 1000)</li>
        <li>(50, 2500)</li>
        <li>(500, 5000)</li>
        <li>(1000, 10000)</li>
        <li>(100000, 100000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
        <li>(500, 0.5)</li>
        <li>(1000, 1)</li>
        <li>(2500, 3)</li>
        <li>(10000000, 4)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Scrin_Buzzer_TBI>40</Scrin_Buzzer_TBI>
          <Scrin_Shocktrooper_TBI>17</Scrin_Shocktrooper_TBI>
          <Scrin_Disintegrator_TBI>40</Scrin_Disintegrator_TBI>
          <Scrin_Mechapede_TBI>3</Scrin_Mechapede_TBI>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Scrin_Shocktrooper_TBI>50</Scrin_Shocktrooper_TBI>
          <Scrin_Disintegrator_TBI>50</Scrin_Disintegrator_TBI>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Scrin_Buzzer_TBI>97</Scrin_Buzzer_TBI>
          <Scrin_Mechapede_TBI>3</Scrin_Mechapede_TBI>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="ScrinFactionBase">
    <defName>Scrin</defName>
    <label>Scrin hive</label>
    <description>A Scrin hive, the center of operations where they harvest Ichor.</description>
    <fixedName>Scrin hive</fixedName>
  </FactionDef>

</Defs>
