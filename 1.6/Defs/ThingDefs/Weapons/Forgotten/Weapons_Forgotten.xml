<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <TiberiumRim.TRThingDef Name="ForgottenGunBase" ParentName="BaseHumanMakeableGun" Abstract="True">
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TR_TibWorkbench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
    <weaponTags>
      <li>Forg_Gun</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="ForgottenGunBase">
    <defName>Forg_Scrapgun</defName>
    <label>scrap gun</label>
    <description>A simple knife submachine pistol made from scrap and other components. Its accuracy is slightly lower, but it remains strong in melee combat.</description>
    <graphicData>
      <texPath>Map/Things/Items/Weapons/Forgotten/Scrapgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.25</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>13000</WorkToMake>
      <Mass>2</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.6</AccuracyShort>
      <AccuracyMedium>0.3</AccuracyMedium>
      <AccuracyLong>0.1</AccuracyLong>
      <RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <ChunkSlagSteel>3</ChunkSlagSteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <techLevel>Industrial</techLevel>
    <weaponTags>
      <li>Scrapgun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_MachinePistol</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>19.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>Shot_MachinePistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponClasses>
      <li>RangedLight</li>
      <li>ShortShots</li>
    </weaponClasses>
    <requisites>
      <tiberiumResearch>
        <li>ForgottenExperimental1</li>
      </tiberiumResearch>
    </requisites>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="ForgottenGunBase">
    <defName>Forg_ShardgunGreen</defName>
    <label>shard gun</label>
    <description>A simple shotgun made from scrap and other components. It launches crushed Tiberium crystals towards the target and may seed the ground with green Tiberium.</description>
    <graphicData>
      <texPath>Map/Things/Items/Weapons/Forgotten/TibShardgun_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>25000</WorkToMake>
      <Mass>5</Mass>
      <AccuracyTouch>0.6</AccuracyTouch>
      <AccuracyShort>0.5</AccuracyShort>
      <AccuracyMedium>0.4</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <ChunkSlagSteel>3</ChunkSlagSteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <techLevel>Industrial</techLevel>
    <weaponTags>
      <li>Shardgun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Shard</defaultProjectile>
        <warmupTime>1.25</warmupTime>
        <range>17.9</range>
        <forcedMissRadius>0.1</forcedMissRadius>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_Shotgun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>5</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponClasses>
      <li>RangedHeavy</li>
      <li>ShortShots</li>
    </weaponClasses>
    <requisites>
      <tiberiumResearch>
        <li>ForgottenExperimental1</li>
      </tiberiumResearch>
    </requisites>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="ForgottenGunBase">
    <defName>Forg_ShardgunBlue</defName>
    <label>chain shard gun</label>
    <description>A heavy scrap-metal chaingun. It launches crushed Tiberium crystals towards the target and may seed the ground with blue Tiberium.</description>
    <graphicData>
      <texPath>Map/Things/Items/Weapons/Forgotten/TibShardgun_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>25000</WorkToMake>
      <Mass>10</Mass>
      <AccuracyTouch>0.4</AccuracyTouch>
      <AccuracyShort>0.35</AccuracyShort>
      <AccuracyMedium>0.3</AccuracyMedium>
      <AccuracyLong>0.25</AccuracyLong>
      <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>ShardgunB</li>
    </weaponTags>
    <costList>
      <Forg_ShardgunGreen>1</Forg_ShardgunGreen>
      <ChunkSlagSteel>3</ChunkSlagSteel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <techLevel>Industrial</techLevel>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ShardB</defaultProjectile>
        <warmupTime>2.2</warmupTime>
        <range>17.9</range>
        <forcedMissRadius>0.1</forcedMissRadius>
        <burstShotCount>12</burstShotCount>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>5</muzzleFlashScale>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
    <weaponClasses>
      <li>RangedHeavy</li>
      <li>ShortShots</li>
    </weaponClasses>
    <requisites>
      <tiberiumResearch>
        <li>ForgottenExperimental1</li>
      </tiberiumResearch>
    </requisites>
  </TiberiumRim.TRThingDef>

</Defs>
