    <modExtensions><li Class="TeleCore.RW.TeleDefExtension"><projectile><impactEffecter>FlechetteHit</impactEffecter><impactFilth><filths><li>FilthTiberiumGreen, 0.1</li></filths><spreadRadius>0</spreadRadius></impactFilth></projectile></li></modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="BaseBullet_TR">
