	<ThingDef ParentName="Gun_GDIBase">
		<defName>Gun_GDIShatterer</defName>
		<label>GDI sonic shatterer</label>
		<description>A compact sonic weapon adapted for Zone Trooper assaults. Its pulsed wave is inaccurate, but punishing against clustered targets and cover.</description>
		<techLevel>Spacer</techLevel>
		<tickerType>Normal</tickerType>
		<graphicData><texPath>Things/Weapons/GDI/Shatterer</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>1.5</drawSize></graphicData>
		<thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
