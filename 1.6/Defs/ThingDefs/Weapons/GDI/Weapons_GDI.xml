	<ThingDef ParentName="Gun_GDIBase">
		<defName>Gun_GDIMobileMortar</defName>
		<label>GDI mobile mortar</label>
		<description>A heavy man-portable mortar for long-range fire support. It is slow, loud, and dangerous near friendlies.</description>
		<tickerType>Normal</tickerType>
		<graphicData><texPath>Things/Weapons/GDI/MobileMortar</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>1.5</drawSize></graphicData>
		<generateCommonality>0.15</generateCommonality>
		<thingSetMakerTags><li>RewardStandardLowFreq</li></thingSetMakerTags>
		<recipeMaker><researchPrerequisite>Mortars</researchPrerequisite><skillRequirements><Crafting>7</Crafting></skillRequirements><displayPriority>452</displayPriority></recipeMaker>
		<statBases><WorkToMake>50000</WorkToMake><Mass>10</Mass><RangedWeapon_Cooldown>6</RangedWeapon_Cooldown></statBases>
		<costList><Steel>90</Steel><Chemfuel>90</Chemfuel><ComponentIndustrial>8</ComponentIndustrial></costList>
		<comps><li Class="CompProperties_Explosive"><explosiveRadius>2.9</explosiveRadius><explosiveDamageType>Bomb</explosiveDamageType><requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode></li></comps>
		<verbs><li><verbClass>Verb_LaunchProjectile</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>Bullet_GDIMortar</defaultProjectile><warmupTime>6</warmupTime><requireLineOfSight>false</requireLineOfSight><range>49.9</range><minRange>9.9</minRange><forcedMissRadius>3.9</forcedMissRadius><burstShotCount>1</burstShotCount><soundCast>Mortar_LaunchA</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><onlyManualCast>true</onlyManualCast><stopBurstWithoutLos>false</stopBurstWithoutLos><muzzleFlashScale>13</muzzleFlashScale><targetParams><canTargetLocations>true</canTargetLocations></targetParams><ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer><ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius></li></verbs>
		<weaponTags><li>GDIMobileMortar</li><li>GunHeavy</li></weaponTags>
		<equippedStatOffsets><MoveSpeed>-0.15</MoveSpeed></equippedStatOffsets>
		<weaponClasses><li>RangedHeavy</li><li>LongShots</li></weaponClasses>
	</ThingDef>

