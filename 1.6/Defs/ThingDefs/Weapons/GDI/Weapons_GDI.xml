<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseHumanMakeableGun" Name="Gun_GDIBase" Abstract="True">
		<soundInteract>Interact_Rifle</soundInteract>
		<recipeMaker>
			<researchPrerequisite>Gunsmithing</researchPrerequisite>
			<skillRequirements><Crafting>5</Crafting></skillRequirements>
		</recipeMaker>
		<weaponTags><li>GDIGun</li></weaponTags>
		<tradeTags><li>WeaponRanged</li></tradeTags>
	</ThingDef>

	<ThingDef ParentName="Gun_GDIBase">
		<defName>Gun_GDIRifle</defName>
		<label>GDI rifle</label>
		<description>A disciplined, reliable GDI service rifle for professional infantry. It has good handling, strong burst fire, and dependable armor-piercing ammunition.</description>
		<graphicData><texPath>Things/Weapons/GDI/Rifle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>1.2</drawSize></graphicData>
		<thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
		<recipeMaker><researchPrerequisite>PrecisionRifling</researchPrerequisite><displayPriority>417</displayPriority></recipeMaker>
		<statBases><WorkToMake>42000</WorkToMake><Mass>3.5</Mass><AccuracyTouch>0.55</AccuracyTouch><AccuracyShort>0.65</AccuracyShort><AccuracyMedium>0.60</AccuracyMedium><AccuracyLong>0.50</AccuracyLong><RangedWeapon_Cooldown>1.70</RangedWeapon_Cooldown></statBases>
		<costList><Steel>65</Steel><ComponentIndustrial>8</ComponentIndustrial></costList>
		<verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>Bullet_GDIRifle</defaultProjectile><warmupTime>1.2</warmupTime><range>28.9</range><burstShotCount>4</burstShotCount><ticksBetweenBurstShots>12</ticksBetweenBurstShots><soundCast>Shot_AssaultRifle</soundCast><soundCastTail>GunTail_Heavy</soundCastTail><muzzleFlashScale>9</muzzleFlashScale></li></verbs>
		<weaponTags><li>GDIRifle</li><li>IndustrialGunAdvanced</li><li>AssaultRifle</li></weaponTags>
		<weaponClasses><li>LongShots</li></weaponClasses>
		<tools><li><label>stock</label><capacities><li>Blunt</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li><li><label>barrel</label><capacities><li>Blunt</li><li>Poke</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li></tools>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_GDIRifle</defName>
		<label>GDI rifle bullet</label>
		<graphicData><texPath>FX/Projectiles/GDI/Bullet_Base</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>TransparentPostLight</shaderType><drawSize>1.5</drawSize></graphicData>
		<projectile><damageDef>Bullet</damageDef><damageAmountBase>12</damageAmountBase><stoppingPower>0.25</stoppingPower><armorPenetrationBase>0.1</armorPenetrationBase><speed>70</speed></projectile>
	</ThingDef>

	<ThingDef ParentName="Gun_GDIBase">
		<defName>Gun_GDIDiscThrower</defName>
		<label>GDI disc thrower</label>
		<description>A compact launcher for explosive GDI discs. It is less elegant than a rifle, but useful for breaching cover and suppressing clusters.</description>
		<tickerType>Normal</tickerType>
		<graphicData><texPath>Things/Weapons/GDI/DiscThrower</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>1.2</drawSize></graphicData>
		<generateCommonality>0.25</generateCommonality>
		<thingSetMakerTags><li>RewardStandardLowFreq</li></thingSetMakerTags>
		<recipeMaker><researchPrerequisite>Machining</researchPrerequisite><skillRequirements><Crafting>6</Crafting></skillRequirements><displayPriority>451</displayPriority></recipeMaker>
		<statBases><WorkToMake>35000</WorkToMake><Mass>4</Mass><RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown></statBases>
		<costList><Steel>70</Steel><Chemfuel>60</Chemfuel><ComponentIndustrial>8</ComponentIndustrial></costList>
		<comps><li Class="CompProperties_Explosive"><explosiveRadius>1.9</explosiveRadius><explosiveDamageType>Bomb</explosiveDamageType><requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode></li></comps>
		<verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>Bullet_GDIDisc</defaultProjectile><warmupTime>3</warmupTime><range>23.9</range><forcedMissRadius>1.9</forcedMissRadius><burstShotCount>1</burstShotCount><soundCast>Shot_IncendiaryLauncher</soundCast><soundCastTail>GunTail_Medium</soundCastTail><muzzleFlashScale>10</muzzleFlashScale><targetParams><canTargetLocations>true</canTargetLocations></targetParams><ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius><ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer></li></verbs>
		<weaponTags><li>GDIGrenadeLauncher</li><li>GunHeavy</li></weaponTags>
		<weaponClasses><li>RangedHeavy</li><li>LongShots</li></weaponClasses>
	</ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_GDIDisc</defName>
