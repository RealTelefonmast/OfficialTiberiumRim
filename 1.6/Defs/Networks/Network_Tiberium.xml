<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TeleCore.RW.Networks.NetworkDef>
    <defName>TiberiumNetwork</defName>
    <label>Tiberium Network</label>
    <labelShort>Tiberium</labelShort>
    <containerLabel>Tiberium Storage</containerLabel>
    <controllerDef>TR_TiberiumNetworkController</controllerDef>
    <transmitterDef>TiberiumPipe</transmitterDef>
    <transmitterGraphic>
      <texPath>Map/Things/Buildings/Common/Network/TiberiumPipe/TiberiumPipe_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </transmitterGraphic>
    <overlayGraphic>
      <texPath>Map/Things/Buildings/Common/Network/TiberiumPipe/TiberiumPipe_Overlay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MetaOverlay</shaderType>
      <color>(155, 255, 0)</color>
    </overlayGraphic>
  </TeleCore.RW.Networks.NetworkDef>
  <TiberiumRim.TRThingDef ParentName="NetworkPipeBase">
    <defName>TiberiumPipe</defName>
    <label>tiberium pipe</label>
    <description>This structure connects Tiberium processing structures on the Tiberium Network.</description>
    <designationCategory Inherit="False" />
    <building>
      <blueprintGraphicData Inherit="False">
        <texPath>Map/Things/Buildings/Common/Network/TiberiumPipe/TiberiumPipe_Blueprint</texPath>
        <graphicClass>TeleCore.RW.Graphic_LinkedWithSame</graphicClass>
      </blueprintGraphicData>
    </building>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>-18</Beauty>
    </statBases>
    <costList>
      <Steel>5</Steel>
    </costList>
    <comps>
      <li Class="TeleCore.RW.Networks.Comps.Properties.CompProperties_Network">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <roles>
              <li>Transmitter</li>
            </roles>
            <volumeConfig>
              <capacity>400</capacity>
              <values>
                <fromCollection>TiberiumNetwork</fromCollection>
              </values>
            </volumeConfig>
          </li>
          <li>
            <networkDef>WasteNetwork</networkDef>
            <roles>
              <li>Transmitter</li>
            </roles>
            <volumeConfig>
              <capacity>400</capacity>
              <values>
                <fromCollection>WasteNetwork</fromCollection>
              </values>
            </volumeConfig>
          </li>
        </networks>
      </li>
    </comps>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TeleCore.RW.Networks.NetworkValueDef>
    <defName>TibGreen</defName>
    <collectionDef>TiberiumNetwork</collectionDef>
    <networkDef>TiberiumNetwork</networkDef>
    <label>green</label>
    <viscosity>0.5</viscosity>
    <valueColor>(111,200,4)</valueColor>
  </TeleCore.RW.Networks.NetworkValueDef>
  <TeleCore.RW.Networks.NetworkValueDef>
    <defName>TibBlue</defName>
    <collectionDef>TiberiumNetwork</collectionDef>
    <networkDef>TiberiumNetwork</networkDef>
    <label>blue</label>
    <viscosity>0.35</viscosity>
    <valueColor>(8,142,208)</valueColor>
  </TeleCore.RW.Networks.NetworkValueDef>
  <TeleCore.RW.Networks.NetworkValueDef>
    <defName>TibRed</defName>
    <collectionDef>TiberiumNetwork</collectionDef>
    <networkDef>TiberiumNetwork</networkDef>
    <label>red</label>
    <viscosity>0.25</viscosity>
    <valueColor>(208,8,42)</valueColor>
  </TeleCore.RW.Networks.NetworkValueDef>
  <TeleCore.RW.Networks.NetworkValueDef>
    <defName>TibSludge</defName>
    <collectionDef>TiberiumNetwork</collectionDef>
    <networkDef>TiberiumNetwork</networkDef>
    <label>sludge</label>
    <valueColor>(160,255,0)</valueColor>
  </TeleCore.RW.Networks.NetworkValueDef>
  <TeleCore.RW.Networks.NetworkValueDef>
    <defName>TibGas</defName>
    <collectionDef>TiberiumNetwork</collectionDef>
    <networkDef>TiberiumNetwork</networkDef>
    <label>gas</label>
    <valueColor>(215,255,165)</valueColor>
  </TeleCore.RW.Networks.NetworkValueDef>
</Defs>
