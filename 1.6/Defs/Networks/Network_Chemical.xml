<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<TeleCore.RW.Networks.NetworkDef>
		<defName>ChemicalNetwork</defName>
		<label>Chemical Network</label>
		<labelShort>Chemical</labelShort>
		<containerLabel>Chemical Storage</containerLabel>
		<!--controllerDef>TR_TiberiumExtractor</controllerDef-->
		<transmitterDef>ChemicalPipe</transmitterDef>
		<transmitterGraphic>
			<texPath>Map/Things/Buildings/Common/Network/ChemicalPipe/ChemicalPipe_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(1,0.75,0)</color>
		</transmitterGraphic>
		<overlayGraphic>
			<texPath>Map/Things/Buildings/Common/Network/ChemicalPipe/ChemicalPipe_Overlay</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>MetaOverlay</shaderType>
			<color>(0, 255, 155)</color>
		</overlayGraphic>
	</TeleCore.RW.Networks.NetworkDef>
	
	<TiberiumRim.TRThingDef ParentName="NetworkPipeBase">
		<defName>ChemicalPipe</defName>
		<label>chemical pipe</label>
		<description>This structure connects Chemical processing structures on the Chemical Network.</description>
		<designationCategory Inherit="False" />
		<building>
			<blueprintGraphicData>
				<texPath>Map/Things/Buildings/Common/Network/ChemicalPipe/ChemicalPipe_Blueprint</texPath>
				<graphicClass>TeleCore.RW.Graphic_LinkedWithSame</graphicClass>
			</blueprintGraphicData>
		</building>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Flammability>0.2</Flammability>
			<Beauty>-18</Beauty>
		</statBases>
		<costList>
			<Steel>5</Steel>
		</costList>
		<comps>
			<li Class="TeleCore.RW.Networks.Comps.Properties.CompProperties_Network">
				<networks>
					<li>
						<networkDef>ChemicalNetwork</networkDef>
						<roles>
							<li>Transmitter</li>
						</roles>
						<volumeConfig>
							<capacity>400</capacity>
							<values>
								<fromCollection>ChemicalNetwork</fromCollection>
							</values>
						</volumeConfig>
					</li>
				</networks>
			</li>
		</comps>
		<modExtensions>
			<li Class="TeleCore.BuildMenu.BuildMenuExtension">
				<groupDef>Common</groupDef>
				<category>Processing</category>
			</li>
		</modExtensions>
	</TiberiumRim.TRThingDef>
	
