<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="PlantBase">
    <defName>TiberiumGrass</defName>
    <label>tiberium grass</label>
    <description>A strange type of grass-like flora. Adapted to Tiberium soils.</description>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
    <graphicData>
      <texPath>Map/Things/Tiberium/Flora/Grass/Green/Base</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <plant>
      <maxMeshCount>4</maxMeshCount>
      <visualSizeRange Inherit="False">
        <min>1</min>
        <max>2</max>
      </visualSizeRange>
      <topWindExposure>0.4</topWindExposure>
      <growDays>2.5</growDays>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>TiberiumBush</defName>
    <label>tiberium bush</label>
    <description>A bunch of different Tiberium flora forming a bush.</description>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
    </statBases>
    <graphicData>
      <texPath>Map/Things/Tiberium/Flora/Bush</texPath>
      <graphicClass>Graphic_Random</graphicClass>
       <shadowData>
         <volume>(0.55, 0.2, 0.2)</volume>
       </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>30</pathCost>
    <plant>
      <maxMeshCount>4</maxMeshCount>
      <visualSizeRange Inherit="False">
        <min>1</min>
        <max>2</max>
      </visualSizeRange>
      <topWindExposure>0.3</topWindExposure>
      <growDays>3</growDays>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>TiberiumShroom</defName>
    <label>tiberium mushroom</label>
    <description>This is what a mushroom would look like, if it were exposed to Tiberium for too long.</description>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>-8</Beauty>
    </statBases>
    <graphicData>
      <texPath>Map/Things/Tiberium/Flora/Shrooms</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <plant>
      <maxMeshCount>4</maxMeshCount>
      <visualSizeRange Inherit="False">
        <min>0.8</min>
        <max>1.8</max>
      </visualSizeRange>
      <topWindExposure>0.3</topWindExposure>
      <growDays>2.5</growDays>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>TiberiumTree</defName>
    <label>tiberium tree</label>
    <description>This seem to be a strange tree, though its wood won't be useful.</description>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <graphicData>
      <texPath>Map/Things/Tiberium/Flora/Tree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <statBases>
      <Beauty>-16</Beauty>
    </statBases>
    <plant>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange Inherit="False">
        <min>1</min>
        <max>2</max>
      </visualSizeRange>
      <growDays>12</growDays>
    </plant>
  </ThingDef>

</Defs>
