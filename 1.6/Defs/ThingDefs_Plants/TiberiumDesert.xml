<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>TiberiumDesertGreen</defName>
    <label>Green Tiberium shards</label>
    <description>Green shards growing out of the sand, they seem to be unstable.</description>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <statBases>
      <MaxHitPoints>15</MaxHitPoints>
      <Beauty>15</Beauty>
    </statBases>
    <graphicData>
      <texPath>Map/Things/Tiberium/Crystals/Green/Desert</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>40</pathCost>
    <plant>
      <maxMeshCount>4</maxMeshCount>
      <visualSizeRange Inherit="False">
        <min>1.0</min>
        <max>2.0</max>
      </visualSizeRange>
      <growDays>4.5</growDays>
    </plant>
  </ThingDef>

