<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Minimal 1.6-safe trader contract required by Factions_Forgotten.xml.
       The broader donor trader family remains preserved in References/. -->
  <TraderKindDef>
    <defName>Caravan_Tiberium_BulkGoods</defName>
    <label>bulk goods trader</label>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>750~1200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>30~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>-10~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Neutroamine</thingDef>
        <countRange>70~160</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
        <thingDefCountRange>3~3</thingDefCountRange>
        <totalPriceRange>150~600</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>BuildingsFurniture</categoryDef>
        <thingDefCountRange>3~3</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag">
        <tag>Art</tag>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>MusicalInstrument</tag>
      </li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
