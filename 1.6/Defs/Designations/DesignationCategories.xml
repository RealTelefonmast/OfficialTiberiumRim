<Defs>

	<!--
	Legacy architect category retained for source traceability. Its
	Designator_TRMenu consumed TRThingDefList, which contained zero build
	entries. TiberiumBuildings/TiberiumMenu is the canonical active menu.
	Removed 2026-09-05 together with TRThingDef.ConstructionOptionDiscovered
	and TRThingDefList; the generic TeleCore.RW.BuildMenu (SubBuildMenuDef +
	TeleCore.SubMenuExtension + Window_BuildMenu) supersedes it. Unported
	TRMenu features for future reference: the locked-reason readout drawn with
	TRContent.LockedBanner, and the public MarkForHighlight hook. The stub file
	UI/Designators/Designator_TRMenu.cs can be deleted.
	<DesignationCategoryDef>
		<defName>Tiberium</defName>
		<label>tiberium</label>
		<order>24</order>
		<specialDesignatorClasses>
		  <li>TiberiumRim.Designator_TRMenu</li>
		</specialDesignatorClasses>
	</DesignationCategoryDef>
	-->

