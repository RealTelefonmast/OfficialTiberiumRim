<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Ported from TiberiumRim-1.3 /Defs/Buildings/GDI/C_Production.xml.
       GDI_Hangar / GDI_TiberiumRefinery / GDIPowerPlant were commented out in
       1.3 but live in the master reference; ported here on the current comp
       formats (volumeConfig, NetworkPowerPlant, TNSRefinery). -->

  <TiberiumRim.TRThingDef ParentName="StationBase_TR">
    <defName>GDI_Factory</defName>
    <label>GDI Factory</label>
    <description>The GDI factory allows you to construct many different items, weapons and units if available.</description>
    <thingClass>Building_WorkTable</thingClass>
    <size>(3,2)</size>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/GDI/Production/Workbench/GDI_Factory</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <recipes>
      <li>MakeReinforcedPlate</li>
      <li>MakeGDISonicCore</li>
    </recipes>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="TiberiumRim.CompProperties_TNS">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>1000</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Requester</li>
            </roles>
          </li>
        </networks>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="StationBase_TR">
    <defName>GDI_Hangar</defName>
    <label>GDI hangar</label>
    <description>This hangar is used for mechanical unit construction.</description>
    <size>(5,5)</size>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconPath>Map/Things/Buildings/GDI/Production/Hangar/GDI_Hangar_Icon</uiIconPath>
    <graphicData>
      <texPath>Map/Things/Buildings/GDI/Production/Hangar/GDI_Hangar_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(7,7)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>500</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
    </costList>
    <inspectorTabs>
      <li>TiberiumRim.Dialogs.ITab_MechConstruction</li>
    </inspectorTabs>
    <comps>
      <li Class="TiberiumRim.CompProperties_MechStation">
        <mechRecipes>
          <li>MakeHarvester_GDI</li>
        </mechRecipes>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/Hangar/GDI_Hangar_Overlay_Lights</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(7,7)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/Hangar/GDI_Hangar_Cover</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <drawSize>(7,7)</drawSize>
            </graphicData>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
      </li>
    </comps>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <fillPercent>1</fillPercent>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="RefineryBase_TR">
    <defName>GDI_TiberiumRefinery</defName>
    <label>tiberium refinery (GDI)</label>
    <description>This refinery will create a Harvester upon construction, which will harvest nearby Tiberium, return and store it inside of the refinery.</description>
    <size>(5,5)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/GDI/Production/Refinery/GDI_Refinery_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5.5,5.5)</drawSize>
    </graphicData>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.85</Flammability>
    </statBases>
    <costList>
      <GDI_ReinforcedPlate>200</GDI_ReinforcedPlate>
      <ComponentIndustrial>100</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="TiberiumRim.CompProperties_TNSRefinery">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>4000</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Producer</li>
            </roles>
          </li>
        </networks>
        <harvester>Harvester_GDI</harvester>
        <generalIOConfig>
          <pattern>
					##OOO##
					#+++++#
					O+++++O
					O++#++O
					O+++++O
					#+++++#
					##OOO##
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TiberiumRim.CompProperties_MechStation">
        <mechRecipes>
          <li>MakeHarvester_GDI</li>
        </mechRecipes>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/Refinery/GDI_Refinery_Overlay_Container</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5.5,5.5)</drawSize>
            </graphicData>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/Refinery/GDI_Refinery_Overlay_Grid2</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(5.5,5.5)</drawSize>
            </graphicData>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/Refinery/GDI_Refinery_Overlay_Connection</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(5.5,5.5)</drawSize>
            </graphicData>
          </li>
        </fxLayers>
      </li>
    </comps>
    <inspectorTabs>
      <li>TiberiumRim.Dialogs.ITab_MechConstruction</li>
    </inspectorTabs>
    <placeWorkers>
      <li>TeleCore.RW.PlaceWorker_Gap</li>
    </placeWorkers>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <interactionCellIcon>RefineryCell</interactionCellIcon>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="StationBase_TR">
    <defName>GDIPowerPlant</defName>
    <label>GDI power plant</label>
    <description>A GDI power plant consuming Tiberium from the network to sustain its output.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconPath>Map/Things/Buildings/GDI/Production/PowerPlant/GDI_PowerPlant_Icon</uiIconPath>
    <graphicData>
      <texPath>Map/Things/Buildings/GDI/Production/PowerPlant/GDI_PowerPlant_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <costList>
      <GDI_ReinforcedPlate>25</GDI_ReinforcedPlate>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="TeleCore.RW.Networks.Comps.Properties.CompProperties_Network">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>2000</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Requester</li>
            </roles>
          </li>
        </networks>
      </li>
      <li Class="TeleCore.RW.Networks.Comps.CompProperties_NetworkPowerPlant">
        <compClass>TeleCore.RW.Networks.Comps.CompPowerPlant_Network</compClass>
        <basePowerConsumption>-4000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <fromNetwork>TiberiumNetwork</fromNetwork>
        <valueToTickRules>
          <li>
            <valueDef>TibGreen</valueDef>
            <cost>1</cost>
            <seconds>1</seconds>
          </li>
          <li>
            <valueDef>TibBlue</valueDef>
            <cost>1</cost>
            <seconds>1.75</seconds>
          </li>
          <li>
            <valueDef>TibRed</valueDef>
            <cost>1</cost>
            <seconds>3</seconds>
          </li>
        </valueToTickRules>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/PowerPlant/GDI_PowerPlant_Overlay_Container</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/PowerPlant/GDI_PowerPlant_Overlay_Lights_Core</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Production/PowerPlant/GDI_PowerPlant_Overlay_Lights_Display</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
        </fxLayers>
        <effectLayers>
          <li>
            <effecterDef>PowerPlantCommonSmoke</effecterDef>
            <layerTag>EffecterPowerPlantSmoke</layerTag>
            <needsPower>true</needsPower>
          </li>
        </effectLayers>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>12</heatPerSecond>
      </li>
    </comps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

</Defs>
