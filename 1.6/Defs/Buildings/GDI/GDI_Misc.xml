<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Ported from TiberiumRim-1.3 /Defs/Buildings/GDI/F_Misc.xml.
       GDI_PowerConduit and Light_GDI remain unported (commented out in 1.3
       as "not cool and no special"). Wall light main texture lacks an _east
       variant in the current art; Graphic_Single stand-in noted below. -->

  <TiberiumRim.TRThingDef ParentName="BuildingBase_TR">
    <defName>GDI_Grave</defName>
    <label>honorable grave</label>
    <description>This honorable grave is for those who fought in the most stressful situations. Our soldiers shall not be forgotten!</description>
    <thingClass>Building_Grave</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <!-- Current art only provides CemeteryOpen_east; Graphic_Single stand-in
           until the full rotation set is added. -->
      <texPath>Map/Things/Buildings/GDI/Civic/Cemetery/GDI_Grave_Open_east</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <WorkToBuild>1150</WorkToBuild>
      <Beauty>25</Beauty>
    </statBases>
    <costList>
      <GDI_ReinforcedPlate>2</GDI_ReinforcedPlate>
    </costList>
    <uiIconPath>Map/Things/Buildings/GDI/Civic/Cemetery/GDI_Grave_Full_north</uiIconPath>
    <constructEffect>ConstructDirt</constructEffect>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <tickerType>Rare</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <passability>PassThroughOnly</passability>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <preventDeteriorationInside>true</preventDeteriorationInside>
      <fullGraveGraphicData>
        <texPath>Map/Things/Buildings/GDI/Civic/Cemetery/GDI_Grave_Full</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1.5,1.5)</drawSize>
      </fullGraveGraphicData>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>CorpsesHumanlike</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <placeWorkers>
      <li>TeleCore.RW.PlaceWorker_Gap</li>
    </placeWorkers>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Misc</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="WallLampBase">
    <defName>GDIWallLight</defName>
    <label>wall light</label>
    <description>An electrical wall lamp that lights an area. People need light to move and work at full speed.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <!-- Current art lacks WallLightGDI_east; Graphic_Single stand-in. -->
      <texPath>Map/Things/Buildings/GDI/Utility/WallLamp/GDI_WallLight_Base_north</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
    </graphicData>
    <requisites>
      <tiberiumResearch>
        <li>GDIExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <comps>
      <li Class="TeleCore.RW.CompProperties_GlowerOffset">
        <glowerDef>GlowSource_GDI_IonBlue</glowerDef>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/GDI/Utility/WallLamp/GDI_WallLight_Overlay_Lights</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(1.5, 1.5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
        </fxLayers>
      </li>
    </comps>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>GDI</groupDef>
        <category>Decoration</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="GlowSourceBase">
    <defName>GlowSource_GDI_IonBlue</defName>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(200,200,255)</glowColor>
      </li>
    </comps>
  </TiberiumRim.TRThingDef>

</Defs>
