<Defs>
  <!-- Ported from TiberiumRim-1.3 /Defs/Buildings/Nod/D_Defense.xml.
       Turret framework moved to TeleCore.RW.Turrets (TurretDefExtension,
       hub core/hub turret classes, place workers). FX layers keep the
       index contract of Building_NodHubTurret / Building_FlameTurret
       (lights = PoweredLights, glow layers rotate with the turret).
       IED_Nuke remains unported (commented out in 1.3; needs the
       TempleShell_Explosive ammo chain).
       The 1.3 hub-turret damageMultipliers (TRRailgun x1.5) were dropped:
       the TRRailgun damage def does not exist in the current tree yet. -->
  <TiberiumRim.TRThingDef Abstract="True" Name="NODTurret" ParentName="TurretBase_TR"></TiberiumRim.TRThingDef>
  <!-- Obelisk Of Light -->
  <TiberiumRim.TRThingDef ParentName="BuildingBase_TR">
    <defName>ObeliskOfLight</defName>
    <label>obelisk of light</label>
    <description>The Brotherhood's most iconic defensive structure. A focused laser beam that vaporizes anything caught in its path.</description>
    <thingClass>TiberiumRim.Building_Obelisk</thingClass>
    <size>(3,3)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Nod/Defense/Obelisk/Nod_Obelisk_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <costList>
      <Nod_CarbonPlate>150</Nod_CarbonPlate>
      <ComponentIndustrial>50</ComponentIndustrial>
    </costList>
    <uiIconPath>Map/Things/Buildings/Nod/Defense/Obelisk/Nod_Obelisk_Icon</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>30000</MarketValue>
      <MaxHitPoints>460</MaxHitPoints>
      <Flammability>0.40</Flammability>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>1000</Mass>
      <Beauty>5</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Obelisk/Nod_Obelisk_Overlay_Lights</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(6,6)</drawSize>
            </graphicData>
            <layerTag>FXObelisk</layerTag>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Obelisk/Nod_Obelisk_Overlay_Charge</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(6,6)</drawSize>
            </graphicData>
            <layerTag>FXObelisk</layerTag>
            <fxMode>Dynamic</fxMode>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <drawOffscreen>true</drawOffscreen>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <specialDisplayRadius>39.9</specialDisplayRadius>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <placeWorkers>
      <li>TeleCore.RW.PlaceWorker_OnlyOutside</li>
    </placeWorkers>
    <requisites>
      <tiberiumResearch>
        <li>NodExperimental3</li>
      </tiberiumResearch>
    </requisites>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Nod</groupDef>
        <category>Defense</category>
      </li>
      <li Class="TeleCore.RW.FXDefExtension">
        <rotateDrawSize>true</rotateDrawSize>
        <alignToBottom>true</alignToBottom>
      </li>
      <li Class="TeleCore.RW.Turrets.Defs.TurretDefExtension">
        <turrets>
          <li>
            <canForceTarget>true</canForceTarget>
            <turretGunDef>Gun_NodObelisk</turretGunDef>
            <turretOffset>(0,0,4.5)</turretOffset>
            <turretBurstWarmupTime>2.85</turretBurstWarmupTime>
            <turretBurstCooldownTime>5</turretBurstCooldownTime>
          </li>
        </turrets>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="NODTurret">
    <defName>Nod_TurretHub</defName>
    <label>turret hub</label>
    <description>Allows you to construct multiple connected turrets.</description>
    <thingClass>TeleCore.RW.Turrets.Hubs.Building_TurretHubCore</thingClass>
    <size>(2,2)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Nod/Defense/HubTurrets/Nod_TurretHub_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.25, 2.25)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>false</castEdgeShadows>
    <uiIconScale>1</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>5000</WorkToBuild>
      <Mass>500</Mass>
      <Beauty>-10</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/HubTurrets/Nod_TurretHub_Overlay_Lights</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(2.25,2.25)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(255,150,150)</glowColor>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shells capacity</fuelLabel>
        <fuelGizmoLabel>Shells capacity</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>Nod_CarbonPlate</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>600</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.25</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <atomicFueling>true</atomicFueling>
        <fuelMultiplier>10</fuelMultiplier>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <outOfFuelMessage>Cannot shoot: Needs shells charge</outOfFuelMessage>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>100</pathCost>
    <fillPercent>0.3</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Nod_CarbonPlate>50</Nod_CarbonPlate>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <filthLeaving>Filth_Ash</filthLeaving>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <requisites>
      <tiberiumResearch>
        <li>NodExperimental2</li>
      </tiberiumResearch>
    </requisites>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Nod</groupDef>
        <category>Defense</category>
      </li>
      <li Class="TeleCore.RW.FXDefExtension">
        <rotateDrawSize>true</rotateDrawSize>
        <alignToBottom>true</alignToBottom>
      </li>
      <li Class="TeleCore.RW.Turrets.Defs.TurretDefExtension">
        <hub>
          <isHub>true</isHub>
          <hubDef>Nod_TurretHub</hubDef>
          <cableTexturePath>Map/Things/Buildings/Nod/Defense/HubTurrets/TurretCable</cableTexturePath>
          <maxTurrets>4</maxTurrets>
        </hub>
        <turrets>
          <li>
            <canForceTarget>true</canForceTarget>
            <turretTop>
              <topGraphic>
                <texPath>Map/Things/Buildings/Nod/Defense/HubTurrets/Shredder/Shredder_BaseNoLightNoBarrels</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>(2.5,2.5)</drawSize>
              </topGraphic>
              <barrels>
                <li>
                  <graphic>
                    <texPath>Map/Things/Buildings/Nod/Defense/HubTurrets/Shredder/Shredder_BarrelLeftNoLight</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(2.5,2.5)</drawSize>
                  </graphic>
                  <barrelOffset>(0,0,-0.05)</barrelOffset>
                  <recoilOffset>(0,0,-0.25)</recoilOffset>
                </li>
                <li>
                  <graphic>
                    <texPath>Map/Things/Buildings/Nod/Defense/HubTurrets/Shredder/Shredder_BarrelRightNoLight</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(2.5,2.5)</drawSize>
                  </graphic>
                  <altitudeOffset>-0.1</altitudeOffset>
                  <barrelOffset>(0,0,-0.05)</barrelOffset>
                  <recoilOffset>(0,0,-0.25)</recoilOffset>
                </li>
              </barrels>
              <aimSpeed>200</aimSpeed>
              <resetSpeed>100</resetSpeed>
              <recoilSpeed>200</recoilSpeed>
            </turretTop>
            <turretGunDef>Gun_ShredderTurret</turretGunDef>
            <turretBurstWarmupTime>1.5</turretBurstWarmupTime>
            <turretBurstCooldownTime>1.5</turretBurstCooldownTime>
          </li>
        </turrets>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
