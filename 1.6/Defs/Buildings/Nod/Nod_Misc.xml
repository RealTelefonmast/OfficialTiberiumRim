<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Ported from TiberiumRim-1.3 /Defs/Buildings/Nod/F_Misc.xml.
       Nod_PowerConduit and Light_Nod remain unported (commented out in 1.3
       as "not cool and no special"). -->

  <TiberiumRim.TRThingDef ParentName="SculptureBase">
    <defName>NodSculptureLarge</defName>
    <label>Brotherhood sculpture</label>
    <description>These statues are a sign of the power of Nod.</description>
    <castEdgeShadows>true</castEdgeShadows>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <!-- Folder path: Graphic_Collection loads every texture under it
           (Relic1-3 + variants + the icon). -->
      <texPath>Map/Things/Buildings/Nod/Utility/Relic</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <uiIconPath>Map/Things/Buildings/Nod/Utility/Relic/Relic_Icon</uiIconPath>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>10</Mass>
      <Beauty>150</Beauty>
      <WorkToMake>30000</WorkToMake>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>250</costStuffCount>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Artistic</workSkill>
      <unfinishedThingDef>UnfinishedSculpture</unfinishedThingDef>
      <effectWorking>Sculpt</effectWorking>
      <soundWorking>Recipe_Sculpt</soundWorking>
      <recipeUsers>
        <li>Nod_Factory</li>
      </recipeUsers>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
    <requisites>
      <tiberiumResearch>
        <li>NodExperimental1</li>
      </tiberiumResearch>
    </requisites>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="WallLampBase">
    <defName>NodWallLight</defName>
    <label>wall light</label>
    <description>An electrical wall lamp that lights an area. People need light to move and work at full speed.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <!-- Current art lacks WallLightNod_east; Graphic_Single stand-in. -->
      <texPath>Map/Things/Buildings/Nod/Utility/WallLamp/WallLightNod_north</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
    </graphicData>
    <requisites>
      <tiberiumResearch>
        <li>NodExperimental1</li>
      </tiberiumResearch>
    </requisites>
    <comps>
      <li Class="TeleCore.RW.CompProperties_GlowerOffset">
        <glowerDef>GlowSource_Nod_Red</glowerDef>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <!-- Current art lacks Glow_east; Graphic_Single stand-in. -->
              <texPath>Map/Things/Buildings/Nod/Utility/WallLamp/Glow_north</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(1.5, 1.5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
        </fxLayers>
      </li>
    </comps>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Nod</groupDef>
        <category>Misc</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>

  <TiberiumRim.TRThingDef ParentName="GlowSourceBase">
    <defName>GlowSource_Nod_Red</defName>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(255,150,150)</glowColor>
      </li>
    </comps>
  </TiberiumRim.TRThingDef>

</Defs>
