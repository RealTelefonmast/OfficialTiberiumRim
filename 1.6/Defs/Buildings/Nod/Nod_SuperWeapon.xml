<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ported from TiberiumRim-1.3 /Defs/Buildings/Nod/A_SuperWeapon.xml.
       FX converted to the current fxLayers format; Building_Temple binds
       layers by index (0-2 toggleable overlays, 3 rotating blades, 4 nuke),
       so the layer order below is load-bearing.
       TemplePrimeTemplate (1.3 dev placeholder) was not ported.
       Textures remapped to the current Nod art tree; the nuke frame binding
       (Nuke0/1/2 launch stages) may need an art pass. -->
  <TiberiumRim.TRThingDef ParentName="BuildingBase_TR">
    <defName>TemplePrime</defName>
    <label>Temple Prime</label>
    <description>The heart of the Brotherhood. Temple Prime coordinates the Nod nuclear silo.</description>
    <thingClass>TiberiumRim.Building_Temple</thingClass>
    <size>(7,7)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Nod/Defense/Temple/Base_Variant02</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(7,8)</drawSize>
      <drawOffset>(0,0,0.5)</drawOffset>
    </graphicData>
    <uiIconPath>Map/Things/Buildings/Nod/Defense/Temple/Temple_Full</uiIconPath>
    <costList>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <superWeapon>
      <designator>TiberiumRim.Designator_NodNukeTargeter</designator>
    </superWeapon>
    <uiIconScale>0.90</uiIconScale>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <tickerType>Normal</tickerType>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>100000</WorkToBuild>
      <Mass>1000</Mass>
      <Beauty>100</Beauty>
    </statBases>
    <comps>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Temple/Main</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(7,8)</drawSize>
            </graphicData>
            <altitude>BuildingOnTop</altitude>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Temple/Entrance</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(7,8)</drawSize>
            </graphicData>
            <altitude>Item</altitude>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Temple/Temple_Overlay_PowerLights</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(7,8)</drawSize>
            </graphicData>
            <altitude>Item</altitude>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Temple/Blades</texPath>
              <graphicClass>TeleCore.RW.Graphic_NumberedCollection</graphicClass>
              <shaderType>Transparent</shaderType>
              <drawSize>(3,3)</drawSize>
            </graphicData>
            <altitude>Building</altitude>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <!-- Nuke0/1/2 are launch-stage frames; Nuke1 bound as the
                   animated missile layer, subject to an art pass. -->
              <texPath>Map/Things/Buildings/Nod/Defense/Temple/Nuke1</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>Transparent</shaderType>
              <drawSize>(2,6)</drawSize>
            </graphicData>
            <altitude>MapDataOverlay</altitude>
            <fxMode>Dynamic</fxMode>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <drawOffscreen>false</drawOffscreen>
    <passability>Impassable</passability>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <specialDisplayRadius>39.9</specialDisplayRadius>
    <constructionSkillPrerequisite>15</constructionSkillPrerequisite>
    <placeWorkers>
      <li>TeleCore.RW.PlaceWorker_OnlyOutside</li>
      <li>TeleCore.RW.PlaceWorker_Once</li>
    </placeWorkers>
    <requisites>
      <tiberiumResearch>
        <li>NodExperimental3</li>
      </tiberiumResearch>
    </requisites>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Nod</groupDef>
        <category>Defense</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="BuildingBase_TR">
    <defName>Nod_TiberiumSuppressor</defName>
    <label>Tiberium-Growth Suppressor</label>
    <description>This specialized facility connects to a nearby Brotherhood of Nod Wall or Laser Fence (needs to be touching) and spreads a suppressing liquid through those. This way Tiberium will be suppressed from further growth near the walls. Requires a huge amount of electricity.</description>
    <thingClass>TiberiumRim.Building_GrowthSuppressor</thingClass>
    <size>(5,5)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Nod/Defense/Suppressor/Nod_Suppressor_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
      <shadowData>
        <volume>(1.4, 0.5, 1.4)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <costList>
      <Nod_CarbonPlate>30</Nod_CarbonPlate>
      <Nod_LQTiberiumCore>3</Nod_LQTiberiumCore>
    </costList>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(255,150,150)</glowColor>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Suppressor/TibSuppressor_Overlay_Light1</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Suppressor/TibSuppressor_Overlay_Light2</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Suppressor/TibSuppressor_Overlay_Light3</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Nod/Defense/Suppressor/TibSuppressor_Overlay_LightCenter</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
            <fxMode>Dynamic</fxMode>
            <fade>
              <opacityRange>0.25~1</opacityRange>
              <opacityDuration>100</opacityDuration>
            </fade>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <passability>Impassable</passability>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Normal</tickerType>
    <statBases>
      <MarketValue>10000</MarketValue>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>25</Beauty>
    </statBases>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <fillPercent>0.40</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <pathCost>75</pathCost>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <requisites>
      <tiberiumResearch>
        <li>TiberiumSuppressionBasic</li>
        <li>NodExperimental3</li>
      </tiberiumResearch>
    </requisites>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Nod</groupDef>
        <category>Defense</category>
      </li>
    </modExtensions>
    <uiIconPath>Map/Things/Buildings/Nod/Defense/Suppressor/Nod_Suppressor_Icon</uiIconPath>
  </TiberiumRim.TRThingDef>
</Defs>