<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TiberiumRim.TRThingDef ParentName="NetworkStationBase">
    <defName>TR_TiberiumNetworkController</defName>
    <label>Tiberium Network Controller</label>
    <description>This structure is the main part of any Tiberium network, it acts as a pump for the entire networks and ensures flow while powered.</description>
    <thingCategories Inherit="false" />
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Network/TNC/TNC_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4.75,4.75)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <size>(4,4)</size>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
    </costList>
    <requisites>
      <tiberiumResearchTasks>
        <li>TiberiumRefining_T5</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="TiberiumRim.CompProperties_TNS">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>2500</capacity>
              <!--<dropContents>true</dropContents>-->
              <leaveContainer>true</leaveContainer>
              <storeEvenly>true</storeEvenly>
              <values>
                <fromCollection>TiberiumNetwork</fromCollection>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Controller</li>
            </roles>
          </li>
          <li>
            <networkDef>WasteNetwork</networkDef>
            <volumeConfig>
              <capacity>2500</capacity>
              <!--<dropContents>true</dropContents>-->
              <leaveContainer>true</leaveContainer>
              <storeEvenly>true</storeEvenly>
              <values>
                <fromCollection>WasteNetwork</fromCollection>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Controller</li>
            </roles>
          </li>
        </networks>
        <generalIOConfig>
          <pattern>
					##XX##|
					##++##|
					X++++X|
					X++++X|
					##++##|
					##XX##
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Network/TNC/TNC_Overlay_Displays</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(4.75,4.75)</drawSize>
            </graphicData>
            <needsPower>true</needsPower>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Network/TNC/TNC_Overlay_Flow</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(4.75,4.75)</drawSize>
            </graphicData>
            <fxMode>Dynamic</fxMode>
            <needsPower>false</needsPower>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(120,255,150,0)</glowColor>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>255</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <tickerType>Normal</tickerType>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <surfaceType>Item</surfaceType>
    <placeWorkers>
      <li>TeleCore.RW.PlaceWorker_Once</li>
    </placeWorkers>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="NetworkStationBase">
    <defName>TR_TiberiumSilo</defName>
    <label>tiberium silo</label>
    <description>Stores Tiberium and distributes it to other Tiberium structures when necessary.</description>
    <size>(3,3)</size>
    <costList>
      <Steel>100</Steel>
    </costList>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(1.9, 1, 1.68)</volume>
        <offset>(-0.03,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>-25</Beauty>
    </statBases>
    <requisites>
      <tiberiumResearchTasks>
        <li>TiberiumRefining_T2</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="TiberiumRim.CompProperties_TNS">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>2500</capacity>
              <!--<dropContents>true</dropContents>-->
              <leaveContainer>true</leaveContainer>
              <storeEvenly>true</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Storage</li>
            </roles>
          </li>
        </networks>
        <generalIOConfig>
          <pattern>
					##X##|
					##+##|
					X+++X|
					##+##|
					##X##
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Overlay_Fill_Base</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MaskedFlowMap</shaderType>
              <drawSize>(3,3)</drawSize>
              <shaderParameters>
                <_FlowSpeed>0.375</_FlowSpeed>
                <_BlendOpacity>0.5</_BlendOpacity>
                <!--SrcAlpha/One: weights the additive contribution by _Color.a, which the FX
                    layer drives with the container fill percent (FX_GetOpacity).-->
                <MySrcMode>5</MySrcMode>
                <MyDstMode>1</MyDstMode>
              </shaderParameters>
            </graphicData>
            <textureParams>
              <_BaseTex>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Overlay_Fill_Base</_BaseTex>
              <_BlendTex1>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Overlay_Fill_Blend_0</_BlendTex1>
              <_BlendTex2>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Overlay_Fill_Blend_1</_BlendTex2>
              <_FlowMap>Map/Things/Buildings/Common/Production/Silo/Common_Silo_FlowMap</_FlowMap>
              <_MaskTex>Map/Things/Buildings/Common/Production/Silo/Common_Silo_FlowMask</_MaskTex>
            </textureParams>
            <fxMode>Dynamic</fxMode>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Container</layerTag>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Silo/Common_Silo_Overlay_Connection</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(3,3)</drawSize>
            </graphicData>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Connection</layerTag>
          </li>
        </fxLayers>
      </li>
    </comps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="RefineryBase_TR">
    <defName>TR_TiberiumRefinery</defName>
    <label>tiberium refinery</label>
    <description>This refinery will create a Harvester upon construction, which will harvest nearby Tiberium, return and store it inside of the refinery.</description>
    <size>(3,4)</size>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4.15,4.15)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.85</Flammability>
    </statBases>
    <costList>
      <Steel>500</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <requisites>
      <tiberiumResearchTasks>
        <li>TiberiumRefining_T4</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="TiberiumRim.CompProperties_MechStation">
        <mechRecipes>
          <li>MakeHarvesterCommon</li>
        </mechRecipes>
      </li>
      <li Class="TiberiumRim.CompProperties_TNSRefinery">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>1500</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Producer</li>
            </roles>
          </li>
        </networks>
        <harvester>Harvester_Common</harvester>
        <generalIOConfig>
          <pattern>
					##O##
					##+##
					O+++O
					O+#+O
					#####
					#####
					</pattern>
          <!--
					UUUUU
					L+#+R
					L+#+R
					L+++R
					##+##
					##D##
					-->
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Overlay_FluidBase</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MaskedFlowMap</shaderType>
              <shaderParameters>
                <_FlowSpeed>0.375</_FlowSpeed>
                <_BlendOpacity>0.5</_BlendOpacity>
                <!--SrcAlpha/One: weights the additive contribution by _Color.a, which the FX
                    layer drives with the container fill percent (FX_GetOpacity).-->
                <MySrcMode>5</MySrcMode>
                <MyDstMode>1</MyDstMode>
              </shaderParameters>
              <drawSize>(4.15,4.15)</drawSize>
            </graphicData>
            <textureParams>
              <_BaseTex>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Overlay_FluidBase</_BaseTex>
              <_BlendTex1>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Overlay_FluidBlend1</_BlendTex1>
              <_BlendTex2>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Overlay_FluidBlend2</_BlendTex2>
              <_FlowMap>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_FlowMap</_FlowMap>
              <_MaskTex>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_FlowMask</_MaskTex>
            </textureParams>
            <fxMode>Dynamic</fxMode>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Container</layerTag>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Overlay_Connector</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <drawSize>(4.15,4.15)</drawSize>
            </graphicData>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Connection</layerTag>
          </li>
        </fxLayers>
      </li>
    </comps>
    <inspectorTabs>
      <li>TiberiumRim.Dialogs.ITab_MechConstruction</li>
    </inspectorTabs>
    <placeWorkers />
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <interactionCellIcon>RefineryCell</interactionCellIcon>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
    <uiIconPath>Map/Things/Buildings/Common/Production/Refinery/Common_Refinery_Base_north</uiIconPath>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="NetworkStationBase">
    <defName>TR_TiberiumSpike</defName>
    <label>tiberium spike</label>
    <thingClass>TiberiumRim.Building_TiberiumSpike</thingClass>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/TiberiumSpike/TibSpike</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,15)</drawSize>
    </graphicData>
    <description>.</description>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <uiIconPath>Map/Things/Buildings/Common/Production/TiberiumSpike/TiberiumSpike_Icon</uiIconPath>
    <uiIconScale>1.25</uiIconScale>
    <constructEffect>ConstructMetal</constructEffect>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>15000</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-30</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(2,2)</size>
    <costList>
      <Steel>300</Steel>
      <Plasteel>75</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
