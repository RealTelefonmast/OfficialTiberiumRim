    <comps>
      <li Class="TeleCore.RW.Networks.Comps.Properties.CompProperties_Network">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>4000</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGas</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Producer</li>
            </roles>
          </li>
        </networks>
        <generalIOConfig>
          <pattern>
					#XX#|
					X++X|
					X++X|
					#XX#|
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/TiberiumSpike/TibSpike</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(3,15)</drawSize>
            </graphicData>
            <altitude>BuildingOnTop</altitude>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/TiberiumSpike/TibSpike</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(3,15)</drawSize>
            </graphicData>
            <altitude>MoteOverhead</altitude>
            <fxMode>Dynamic</fxMode>
            <needsPower>true</needsPower>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <placeWorkers>
      <li>TiberiumRim.Vis.Placeworkers.PlaceWorker_OnTiberiumGeyser</li>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="NetworkStationBase">
    <defName>TR_TiberiumPowerPlant</defName>
    <label>Tiberium powerplant</label>
    <description>This power plant needs to be connected to a Tiberium network before it can properly operate, it will automatically consume Tiberium from the network to sustain itself.</description>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(4,4)</size>
    <costList>
      <Steel>250</Steel>
      <Uranium>25</Uranium>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <requisites>
      <tiberiumResearchTasks>
        <li>TiberiumPower_T2</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="TiberiumRim.CompProperties_TNS">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>1000</capacity>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibRed</li>
                  <li>TibBlue</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Requester</li>
            </roles>
          </li>
        </networks>
        <generalIOConfig>
          <pattern>
					#XXXX#|
					X####X|
					X####X|
					X####X|
					X####X|
					#XXXX#|
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.Networks.Comps.CompProperties_NetworkPowerPlant">
        <compClass>TeleCore.RW.Networks.Comps.CompPowerPlant_Network</compClass>
        <basePowerConsumption>-3000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <fromNetwork>TiberiumNetwork</fromNetwork>
        <valueToTickRules>
          <li>
            <valueDef>TibGreen</valueDef>
            <cost>1</cost>
            <seconds>1</seconds>
          </li>
          <li>
            <valueDef>TibBlue</valueDef>
            <cost>1</cost>
            <seconds>1.75</seconds>
          </li>
          <li>
            <valueDef>TibRed</valueDef>
            <cost>1</cost>
            <seconds>3</seconds>
          </li>
          <li>
            <valueDef>TibSludge</valueDef>
            <cost>10</cost>
            <seconds>1</seconds>
          </li>
        </valueToTickRules>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Base</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <shaderType>MaskedFlowMap</shaderType>
              <drawSize>(5,5)</drawSize>
              <shaderParameters>
                <_FlowSpeed>0.375</_FlowSpeed>
                <_BlendOpacity>0.5</_BlendOpacity>
                <!-- SrcAlpha/One: weights the additive contribution by _Color.a, which the FX
                    layer drives with the network fill percent (FX_GetOpacity). -->
                <MySrcMode>5</MySrcMode>
                <MyDstMode>1</MyDstMode>
              </shaderParameters>
            </graphicData>
            <textureParams>
              <_BaseTex>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Base</_BaseTex>
              <_BlendTex1>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Flow1</_BlendTex1>
              <_BlendTex2>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Flow2</_BlendTex2>
              <_FlowMap>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_FlowMap</_FlowMap>
              <_MaskTex>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Mask</_MaskTex>
            </textureParams>
            <fxMode>Dynamic</fxMode>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Container</layerTag>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/PowerPlant/Common_PowerPlant_Overlay_Connection</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(5,5)</drawSize>
            </graphicData>
            <categoryTag>FXNetwork</categoryTag>
            <layerTag>Connection</layerTag>
          </li>
        </fxLayers>
        <effectLayers>
          <li>
            <effecterDef>PowerPlantCommonSmoke</effecterDef>
            <layerTag>EffecterPowerPlantSmoke</layerTag>
            <needsPower>true</needsPower>
          </li>
        </effectLayers>
        <!-- TODO: Move to fleck thrower
				<moteData>
					<northVec>
						<li>(-1.35,0,-0.18)</li>
						<li>(1.35,0,-0.18)</li>
					</northVec>
					<thrower>
						<moteDef>TiberiumSmokeMote</moteDef>
						<speed>1.5</speed>
						<scale>0.5</scale>
						<rotation>0~90</rotation>
						<rotationRate>0.1</rotationRate>
						<angle>0~50</angle>
						<burstCount>1</burstCount>
						<affectedByWind>true</affectedByWind>
						<moteInterval>15~25</moteInterval>
					</thrower>
				</moteData>
				-->
      </li>
      <li Class="CompProperties_Flickable" />
