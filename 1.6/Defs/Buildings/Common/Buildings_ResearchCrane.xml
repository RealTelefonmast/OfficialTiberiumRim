<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TiberiumRim.TRThingDef ParentName="StationBase_TR">
    <defName>TiberiumResearchCrane</defName>
    <label>tiberium research crane</label>
    <description>This research crane can be placed on any Tiberium source and will allow you to learn more about the alien substance. It is immune to Tiberium itself and will inhibit the producer from spawning more Tiberium.\n\nOnly one research crane can be placed on a map.</description>
    <size>(5,5)</size>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <TRCategory>Research</TRCategory>
    <destroyTiberium>true</destroyTiberium>
    <clearTiberium>true</clearTiberium>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconPath>Map/Things/Buildings/Common/Research/ResearchCrane/ResearchCrane_Original</uiIconPath>
    <graphicData>
      <texPath>Blank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,8)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <building>
      <blueprintGraphicData>
        <texPath>Map/Things/Buildings/Common/Research/ResearchCrane/ResearchCrane_Blueprint</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(8,8)</drawSize>
      </blueprintGraphicData>
      <isEdifice>true</isEdifice>
      <expandHomeArea>false</expandHomeArea>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <TiberiumDamageResistance>1</TiberiumDamageResistance>
      <!--<ResearchSpeedFactor>1.0</ResearchSpeedFactor>-->
    </statBases>
    <comps>
      <li Class="TeleCore.RW.Animation.Runtime.CompProperties_AnimationRenderer">
        <animationDef>ResearchCrane</animationDef>
        <defaultAnimationTag>Idle</defaultAnimationTag>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>110</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <fillPercent>0.75</fillPercent>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <rotatable>false</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <surfaceType>Item</surfaceType>
    <requisites>
      <tiberiumResearchTasks>
        <li>MineralAnalysis_T3</li>
      </tiberiumResearchTasks>
    </requisites>
    <placeWorkers>
      <li>TiberiumRim.Vis.Placeworkers.PlaceWorker_ResearchCrane</li>
      <li>TeleCore.RW.PlaceWorker_Once</li>
    </placeWorkers>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Research</category>
      </li>
      <li Class="TeleCore.RW.GraphicOverrideExtensions">
        <ghostGraphic>
          <texPath>Map/Things/Pawns/Mechanical/Common/Harvester/Blueprint</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(8,8)</drawSize>
        </ghostGraphic>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
</Defs>