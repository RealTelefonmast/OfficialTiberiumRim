<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TiberiumRim.TRThingDef ParentName="BenchBase_TR">
    <defName>TR_TibWorkbench</defName>
    <label>tiberium workbench</label>
    <description>This structure can be used to craft Tiberium specific items.</description>
    <thingClass>Building_WorkTable</thingClass>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,2)</size>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/Workbench/Bench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>3.3</drawSize>
      <shadowData>
        <volume>(1.5,1,1.5)</volume>
      </shadowData>
      <damageData>
        <rect>(0.3,0.1,2.4,1.8)</rect>
      </damageData>
    </graphicData>
    <inspectorTabs>
      <li>ITab_Bills</li>
      <li>TeleCore.RW.Networks.ITab_NetworkDebug</li>
    </inspectorTabs>
    <recipes>
      <li>MakeDronePackage_Common</li>
    </recipes>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <surfaceType>Item</surfaceType>
    <requisites>
      <tiberiumResearchTasks>
        <li>MineralAnalysis_T4</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>125</basePowerConsumption>
      </li>
      <li Class="TiberiumRim.CompProperties_TNS">
        <networks>
          <li>
            <networkDef>TiberiumNetwork</networkDef>
            <volumeConfig>
              <capacity>1000</capacity>
              <area>1</area>
              <elevation>0</elevation>
              <height>1</height>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibGreen</li>
                  <li>TibBlue</li>
                  <li>TibRed</li>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Requester</li>
            </roles>
          </li>
        </networks>
        <generalIOConfig>
          <pattern>
					##X##
					X###X
					#####
					#####
					</pattern>
        </generalIOConfig>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Workbench/Overlay</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>3.3</drawSize>
            </graphicData>
            <fxMode>Dynamic</fxMode>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/Workbench/Connection</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <drawSize>3.3</drawSize>
            </graphicData>
          </li>
        </fxLayers>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
  <TiberiumRim.TRThingDef ParentName="BenchBase_TR">
    <defName>TR_AtomicSynthesizer</defName>
    <label>Atomic Synthesizer</label>
    <description>A specialized elemental refining plant.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Map/Things/Buildings/Common/Production/ChemicalPlant/ChemicalPlant_Base</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Plasteel>25</Plasteel>
      <Steel>150</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <requisites>
      <tiberiumResearchTasks>
        <li>TiberiumRefining_T7</li>
      </tiberiumResearchTasks>
    </requisites>
    <comps>
      <li Class="TeleCore.RW.Networks.Comps.CompProperties_NetworkBillsCrafter">
        <compClass>TeleCore.RW.Networks.Comps.Comp_NetworkBillsCrafter</compClass>
        <ratioTags>
          <li>TiberiumRatios</li>
        </ratioTags>
        <presetTags>
          <li>TiberiumPresets</li>
        </presetTags>
        <networks>
          <li>
            <networkDef>ChemicalNetwork</networkDef>
            <roles>
              <li>EndPoint</li>
              <li>Transmitter</li>
            </roles>
            <netIOConfig>
              <pattern>
							#L#L#
							#+#+#
							L+#+L
							#+#+#
							#####
							</pattern>
            </netIOConfig>
          </li>
          <li>
            <networkDef>WasteNetwork</networkDef>
            <volumeConfig>
              <capacity>250</capacity>
              <area>1</area>
              <elevation>0</elevation>
              <height>1</height>
              <leaveContainer>true</leaveContainer>
              <storeEvenly>false</storeEvenly>
              <values>
                <allowedValues>
                  <li>TibSludge</li>
                </allowedValues>
              </values>
            </volumeConfig>
            <roles>
              <li>Transmitter</li>
              <li>Producer</li>
            </roles>
            <netIOConfig>
              <pattern>
							##O##
							O+#+O
							#+#+#
							#+#+#
							#####
							</pattern>
            </netIOConfig>
          </li>
        </networks>
      </li>
      <li Class="TeleCore.RW.CompProperties_FX">
        <fxLayers>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/ChemicalPlant/ChemicalPlant_Overlay_Liquid</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <shaderType>MoteGlow</shaderType>
              <drawSize>(4,4)</drawSize>
            </graphicData>
          </li>
          <li>
            <graphicData>
              <texPath>Map/Things/Buildings/Common/Production/ChemicalPlant/ChemicalPlant_Overlay_Connector</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <drawSize>(4,4)</drawSize>
            </graphicData>
          </li>
        </fxLayers>
        <!-- TODO: Move to fleck thrower
				<moteData>
					<northVec>
						<li>(-1.1,0,1.9)</li>
						<li>(1.1,0,1.9)</li>
					</northVec>
					<eastVec>
						<li>(1.2,0,1.5)</li>
						<li>(1.2,0,-0.15)</li>
					</eastVec>
					<southVec>
						<li>(-1.1,0,-0.15)</li>
						<li>(1.1,0,-0.15)</li>
					</southVec>
					<thrower>
						<moteDef>TiberiumSmokeMote</moteDef>
						<speed>1.5</speed>
						<scale>0.5</scale>
						<rotation>0~90</rotation>
						<rotationRate>0.1</rotationRate>
						<angle>0~50</angle>
						<burstCount>1</burstCount>
						<affectedByWind>true</affectedByWind>
						<moteInterval>15~25</moteInterval>
					</thrower>
				</moteData>
				-->
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <!--
		<recipes>
			<li>ExtractSteel</li>
			<li>ExtractPlasteel</li>
			<li>ExtractGold</li>
			<li>ExtractUranium</li>
			<li>BurnSludge</li>
		</recipes>
		-->
    <tickerType>Normal</tickerType>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <inspectorTabs>
      <li>TeleCore.RW.Networks.ITab_CustomNetworkBills</li>
      <li>TeleCore.RW.Networks.ITab_NetworkDebug</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <surfaceType>Item</surfaceType>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <modExtensions>
      <li Class="TeleCore.BuildMenu.BuildMenuExtension">
        <groupDef>Common</groupDef>
        <category>Processing</category>
      </li>
      <li Class="TeleCore.RW.TeleDefExtension">
        <thingGroups>
          <groups>
            <li>TiberiumCrafters</li>
          </groups>
        </thingGroups>
      </li>
    </modExtensions>
  </TiberiumRim.TRThingDef>
</Defs>