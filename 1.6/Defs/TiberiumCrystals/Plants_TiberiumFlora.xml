<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<TiberiumRim.TRThingDef ParentName="PlantBase_TR">
		<defName>TiberiumGrass_Blue</defName>
		<label>blue tiberium grass</label>
		<description>A strange type of grass-like flora, don't get entangled in the tentacles!</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Beauty>-12</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<graphicData>
			<texPath>Tiberium/Flora/Grass/Blue</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<!--
		<graphicData2>
			<texPath>Tiberium/Flora/Grass/Blue/FX</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shaderType>MoteGlow</shaderType>
		</graphicData2>
		-->
		<plant>
			<harvestedThingDef>TiberiumPlantGrass</harvestedThingDef>
			<harvestYield>6</harvestYield>
			<growDays>2.5</growDays>
		</plant>
	</TiberiumRim.TRThingDef>
  
	<TiberiumRim.TRThingDef Abstract="True" Name="ShroomBase" ParentName="PlantBase_TR">
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Beauty>-10</Beauty>
			<Flammability>0</Flammability>
		</statBases>
		<plant>
			<harvestedThingDef>TiberiumPlantShroom</harvestedThingDef>
			<harvestYield>6</harvestYield>
			<growDays>2.5</growDays>
			<visualSizeRange>
				<min>0.8</min>
				<max>1.8</max>
			</visualSizeRange>
			<wildClusterRadius>4</wildClusterRadius>
		</plant>
	</TiberiumRim.TRThingDef>
  
	<TiberiumRim.TRThingDef ParentName="ShroomBase">
		<defName>TiberiumShroom_Yellow</defName>
		<label>yellow tiberium mushroom</label>
		<description>This glowy plant resembles a mushroom, strange what Tiberium radiation can create.</description>
		<graphicData>
			<texPath>Tiberium/Flora/Shroom</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<!--
		<graphicData2>
			<texPath>Tiberium/Flora/Shroom/FX</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shaderType>MoteGlow</shaderType>
		</graphicData2>
		-->
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(70,110,0,0)</glowColor>
			</li>
		</comps>
	</TiberiumRim.TRThingDef>

