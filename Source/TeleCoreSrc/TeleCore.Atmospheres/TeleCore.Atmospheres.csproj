        <AssemblyName>TeleCore.Atmospheres</AssemblyName>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <OutputPath>..\..\1.6\Assemblies\</OutputPath>
