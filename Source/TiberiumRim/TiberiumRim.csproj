<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>TR</RootNamespace>
        <AssemblyName>TiberiumRim</AssemblyName>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <OutputPath>..\..\1.6\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <UseCommonOutputDirectory>true</UseCommonOutputDirectory>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.*</AssemblyVersion>
        <Deterministic>false</Deterministic>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>full</DebugType>
        <DefineConstants>TRACE;DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all"/>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" GeneratePathProperty="true"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime"/>
        <PackageReference Include="UnlimitedHugs.Rimworld.HugsLib" Version="12.0.0" ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Exclude the old nested project folder (duplicates of files at this level) -->
        <Compile Remove="TiberiumRim\**"/>
        <Compile Remove="TeleCoreSrc\**"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="Assembly-CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>TeleCoreSrc\TeleCore\obj\Debug\PublicizedAssemblies\Assembly-CSharp.878BEDC6BF7C7756A8661A89C882394A\Assembly-CSharp.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TeleCoreSrc\TeleCore.Research\TeleCore.Research.csproj"/>
        <ProjectReference Include="..\TeleCoreSrc\TeleCore\TeleCore.csproj"/>
        <ProjectReference Include="TeleCoreSrc\TeleCore\TeleCore.csproj"/>
        <ProjectReference Include="..\TeleCoreSrc\TeleCore.Atmosphere\TeleCore.Atmosphere.csproj"/>
    </ItemGroup>

</Project>
