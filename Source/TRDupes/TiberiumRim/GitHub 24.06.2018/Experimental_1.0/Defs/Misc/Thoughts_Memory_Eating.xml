<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>SoakingTib</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>contaminated (dry)</label>
        <description>I walked into tiberium field and now I'm feel some contaminated.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>SoakingTibWater</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>contaminated (wet)</label>
        <description>I walked into tiberium water and now I'm feel contaminated.</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  

  <ThoughtDef>
    <defName>AteTiberiumMeatDirect</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/Food</icon>
		<durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>ate tiberium meat</label>
        <description>I ate some glowing, green crunchy meat. I think I'm dying.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

	<ThoughtDef>
		<defName>AteTiberiumMeatAsIngredient</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/Food</icon>
		<durationDays>1</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>ate cooked tiberium meat</label>
				<description>I ate a meal cooked from glowing, crunchy meat. The seasoning partly covered the taste, but there were spikey pieces and now a burning sensation is covering my tongue. I feel sick.</description>
				<baseMoodEffect>-10</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>
	
  <ThoughtDef>
    <defName>AteMutatedMeatDirect</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/Food</icon>
		<durationDays>0.5</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>ate mutated meat</label>
        <description>I ate some glowing, tough meat, it tastes terrible.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

	<ThoughtDef>
		<defName>AteMutatedMeatAsIngredient</defName>
		<showBubble>true</showBubble>
		<icon>Things/Mote/ThoughtSymbol/Food</icon>
		<durationDays>0.5</durationDays>
		<stackLimit>3</stackLimit>
		<stages>
			<li>
				<label>ate cooked mutated meat</label>
				<description>I ate a meal cooked from glowing meat. The seasoning partly covers the horrible aftertaste.</description>
				<baseMoodEffect>-5</baseMoodEffect>
			</li>
		</stages>
	</ThoughtDef>

</Defs>