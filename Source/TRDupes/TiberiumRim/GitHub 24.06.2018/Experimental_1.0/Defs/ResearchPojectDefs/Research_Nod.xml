<!--tier4-->
	<ResearchProjectDef ParentName="TRProject">
		<defName>NodResearch_AdvancedSecurity</defName>
		<label>Advanced Defense</label>
		<description>Get access to advanced Nod security structures. Unlocks the Obelisk of Light.</description>
		<baseCost>3500</baseCost>
		<prerequisites>
			<li>NodResearch_Security</li>
			<li>NodResearch_AdvancedTechnology</li>
		</prerequisites>
