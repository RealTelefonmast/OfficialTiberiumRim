		<researchViewY>3.5</researchViewY>
	</ResearchProjectDef>	
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>NodResearch_LiquidTechnology</defName>
		<label>Liquid Ichor</label>
		<description>Nod's efforts have proven well, it is finally possible to liquify Tiberium and harness it's true power. Use it wisely commander. Unlocks Liquid Tiberium items.</description>
		<baseCost>4000</baseCost>
		<prerequisites>
			<li>NodResearch_AdvancedTechnology</li>
		</prerequisites>
		<requiredResearchFacilities>
			<li>Nod_Grave</li>
		</requiredResearchFacilities>		
		<researchViewX>7</researchViewX>
		<researchViewY>4.25</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>NodResearch_AdvancedProduction</defName>
