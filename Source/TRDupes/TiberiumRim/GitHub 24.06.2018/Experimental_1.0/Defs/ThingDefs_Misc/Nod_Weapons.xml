      <!-- Nod Rifle -->
	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_NodRifle</defName>
		<label>bullet</label>
		<description>bullet</description>
		<graphicData>
		<texPath>Equipments/Weapons/Projectile/Bullet_Base_Nod</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>6</damageAmountBase>
			<speed>75</speed>
			<stoppingPower>0.5</stoppingPower>
		</projectile>
	</ThingDef>
	  
	<ThingDef ParentName="Nod_MakeableGun">
		<defName>Gun_NodRifle</defName>
		<label>Nod rifle</label>
		<description>A general-purpose military weapon for field or urban combat. Specialized by Nod technology.\n\nUpgradable to Nod laser rifle.\n\nUpgradable to Nod flamethrower.</description>
		<graphicData>
			<texPath>Equipments/Weapons/Nod_Rifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<MarketValue>750</MarketValue>
			<WorkToMake>30000</WorkToMake>
			<Mass>2</Mass>
			<AccuracyTouch>0.75</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Weapon_Bulk>1</Weapon_Bulk>
		</statBases>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_NodRifle</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>25</range>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>Interact_AssaultRifle</soundCast>
				<soundCastTail>Shot_Nod_GunTail</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<weaponTags>
			<li>NodRifle</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>NodResearch_Technology</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
		
