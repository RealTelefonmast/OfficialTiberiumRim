	<!-- Nod Laser Rifle -->
	<ThingDef Class="JecsTools.ThingDef_LaserProjectile" ParentName="BaseBullet">
		<defName>Bullet_LaserRifle</defName>
		<label>laser</label>
		<description>laser</description>
		<graphicData>
			<texPath>Equipments/Weapons/Projectile/Bullet_Nod_LaserBeam</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile>
			<damageDef>TRLaser</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<stoppingPower>1</stoppingPower>
			<speed>80</speed>
		</projectile>
		<thingClass>JecsTools.Projectile_Laser</thingClass>
		<graphicSettings>
		  <li>
		    <offset>(0,-1,0.1)</offset>
