	<!-- GDI Advanced Rifles -->
	<ThingDef Class="JecsTools.ThingDef_LaserProjectile" ParentName="BaseBullet">
		<defName>Bullet_Railgun</defName>
		<label>railgun bolt</label>
		<description>railgun bolt</description>
