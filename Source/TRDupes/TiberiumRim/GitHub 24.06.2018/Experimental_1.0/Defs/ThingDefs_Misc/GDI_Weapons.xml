	<ThingDef ParentName="GDI_MakeableGun">
		<defName>Gun_GDIRifle</defName>
		<label>GDI rifle</label>
		<description>A general-purpose military weapon for field or urban combat.\n\nUpgradable to GDI railgun.</description>
		<graphicData>
			<texPath>Equipments/Weapons/GDI_Rifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<MarketValue>750</MarketValue>
			<WorkToMake>30000</WorkToMake>
			<Mass>3.0</Mass>
			<AccuracyTouch>0.75</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.55</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
