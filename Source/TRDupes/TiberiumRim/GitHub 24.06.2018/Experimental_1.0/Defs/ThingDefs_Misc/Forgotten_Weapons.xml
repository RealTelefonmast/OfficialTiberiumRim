<?xml version="1.0" encoding="utf-8" ?>

<Defs>
		<ThingDef ParentName="BaseBullet">
		<defName>Bullet_Shard</defName>
		<label>Green tiberium shard</label>
		<description>Green tiberium shard</description>
		<graphicData>
			<texPath>Equipments/Weapons/Projectile/Bullet_TiberiumA</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<thingClass>Projectile_Explosive</thingClass>
		<projectile>
			<damageDef>TRTiberiumshotGreen</damageDef>
			<damageAmountBase>8</damageAmountBase>
			<explosionRadius>0.025</explosionRadius>
			<!--
			<preExplosionSpawnThingDef>TiberiumGreen</preExplosionSpawnThingDef>
			<preExplosionSpawnChance>0.1</preExplosionSpawnChance>
			-->
			<postExplosionSpawnThingDef>FilthTiberiumGreen</postExplosionSpawnThingDef>
			<postExplosionSpawnChance>0.15</postExplosionSpawnChance>
			<speed>50</speed>
			<soundExplode>BulletImpact_Flesh</soundExplode>
		</projectile>
		</ThingDef>
	
	<ThingDef ParentName="BaseGun">
		<defName>Gun_Shardgun</defName>
		<label>Shard gun</label>
		<description>A scrap shard gun. This weapon creates green tiberium pollute.</description>
		<graphicData>
			<texPath>Equipments/Weapons/Forgotten_TibShardGun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.25</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>1000</MarketValue>
			<Mass>2</Mass>
			<AccuracyTouch>0.40</AccuracyTouch>
			<AccuracyShort>0.35</AccuracyShort>
			<AccuracyMedium>0.30</AccuracyMedium>
			<AccuracyLong>0.25</AccuracyLong>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<Weapon_Bulk>2</Weapon_Bulk>
		</statBases>
		<costList>
			<Steel>75</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Uranium>1</Uranium>
		</costList>
		<techLevel>Industrial</techLevel>
		<weaponTags>
			<li>Shardgun</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Shard</defaultProjectile>
				<warmupTime>2</warmupTime>
				<range>15</range>
				<forcedMissRadius>0.1</forcedMissRadius>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>0</ticksBetweenBurstShots>
				<soundCast>Shot_Nod_Shredder</soundCast>
				<soundCastTail>Shot_Nod_GunTail</soundCastTail>
				<muzzleFlashScale>14</muzzleFlashScale>
			</li>
		</verbs>
		<recipeMaker>
			<recipeUsers>
				<li>TiberiumResearchCraftingBench</li>				
			</recipeUsers>
		</recipeMaker>
		<comps>
		  <li>
		    <compClass>CompOversizedWeapon.CompOversizedWeapon</compClass>
		  </li>
		</comps>
	</ThingDef>
	
