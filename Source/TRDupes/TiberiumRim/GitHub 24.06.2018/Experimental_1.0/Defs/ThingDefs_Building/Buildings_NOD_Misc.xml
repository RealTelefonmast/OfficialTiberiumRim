  <ThingDef ParentName="BuildingBase">
    <defName>Nod_PowerConduit</defName>
    <label>nod power conduit</label>
    <description>A set of electrical cables for moving power around. Can be placed under walls and other buildings. Nod's hardening techniques make it fireproof.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Building/Nod/Misc/LaserPC</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags>
        <li>PowerConduit</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Building/Nod/Misc/LaserPC_Icon</uiIconPath>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <placingDraggableDimensions>1</placingDraggableDimensions>
    <costList>
      <Steel>3</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
	  <li Class="CompProperties_Glower">
				<glowRadius>1</glowRadius>
				<glowColor>(255,150,150)</glowColor>
	  </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_Conduit</li>
    </placeWorkers>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <clearBuildingArea>false</clearBuildingArea>
	<building>
		<ai_chillDestination>false</ai_chillDestination>
		<isInert>true</isInert>
		<isEdifice>false</isEdifice>
		<blueprintGraphicData>
			<texPath>Building/Nod/Misc/LaserPC_Blueprint</texPath>
		</blueprintGraphicData>
	</building>
    <researchPrerequisites><li>NodResearch_Technology</li></researchPrerequisites>
	<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>
  
  <ThingDef ParentName="LampBase">
    <defName>Light_Nod</defName>
    <label>Light of Nod</label>
    <description>Every Nod believers fanatically prefers deep red light. It's cool, but there's no doubt that it's unhealthy for their eye.</description>
    <graphicData>
      <texPath>Building/Nod/Misc/Light_Nod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
	  <Beauty>20</Beauty>
	  <MaxHitPoints>75</MaxHitPoints>
	  <WorkToMake>330</WorkToMake>
	  <Mass>15</Mass>
	  <Flammability>0.0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <glowColor>(255,150,150)</glowColor>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
    <costList>
      <Steel>15</Steel>
	  <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
	<designationCategory>Furniture</designationCategory>
    <researchPrerequisites><li>NodResearch_Technology</li></researchPrerequisites>
	<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>
	
  <ThingDef ParentName="LampBase">
    <defName>NodWallLight</defName>
    <label>Wall Light of Nod</label>
	<description>Every Nod believers fanatically prefers deep red light. It's cool, but there's no doubt that it's unhealthy for their eye.</description>
    <graphicData>
      <texPath>Building/Nod/Misc/WallLightNod</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.5,1.5</drawSize>
    </graphicData>
    <altitudeLayer>Blueprint</altitudeLayer>
    <passability>Standable</passability>
	<statBases>
	  <Beauty>20</Beauty>
	  <MaxHitPoints>75</MaxHitPoints>
	  <WorkToMake>330</WorkToMake>
	  <Mass>15</Mass>
	  <Flammability>0.0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>10</Steel>
	  <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <uiIconPath>Building/Nod/Misc/Icon_WallLightNod</uiIconPath>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(255,150,150)</glowColor>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <rotatable>true</rotatable>
    <clearBuildingArea>false</clearBuildingArea>
	<designationCategory>Furniture</designationCategory>
    <researchPrerequisites><li>NodResearch_Technology</li></researchPrerequisites>
	<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>

	
</Defs>