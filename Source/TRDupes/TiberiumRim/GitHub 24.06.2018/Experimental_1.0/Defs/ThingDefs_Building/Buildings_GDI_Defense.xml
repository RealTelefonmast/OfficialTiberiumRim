<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="DoorBase">
		<defName>GDI_Door</defName>
		<label>GDI door</label>
		<description>Divides rooms. Must be manually opened and closed, which slows people down.</description>
		<graphicData>
			<texPath>Building/GDI/Defense/Door_GDI</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<costList>
			<GDI_ReinforcedPlate>4</GDI_ReinforcedPlate>
		</costList>
		<uiIconPath>Building/GDI/Defense/Door_GDI_icon</uiIconPath>
		<designationCategory>Structure</designationCategory>
		<researchPrerequisites><li>GDIResearch_Buildings</li></researchPrerequisites>
		<statBases>
			<WorkToBuild>750</WorkToBuild>
			<MaxHitPoints>750</MaxHitPoints>
			<Flammability>0.0</Flammability>
		</statBases>
		<damageMultipliers>
		<li>
			<damageDef>TRSound</damageDef>
			<multiplier>0.5</multiplier>
		</li>
		</damageMultipliers>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
	</ThingDef>

	<ThingDef ParentName="DoorBase">
		<defName>GDI_Autodoor</defName>
		<label>GDI autodoor</label>
		<description>Divides rooms. Powered operation allows people to move through the door without slowing down.</description>
		<graphicData>
		<texPath>Building/GDI/Defense/AutoDoor_GDI</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		<damageData>
			<enabled>false</enabled>
		</damageData>
		</graphicData>
		<uiIconPath>Building/GDI/Defense/AutoDoor_GDI_icon</uiIconPath>
		<costList>
			<GDI_ReinforcedPlate>4</GDI_ReinforcedPlate>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>50</basePowerConsumption>
			</li>
			<li Class="CompProperties_Breakdownable"/>
				<li Class="CompProperties_Glower">
				<glowRadius>2</glowRadius>
				<glowColor>(200,200,255)</glowColor>
			</li>
		</comps>
		<designationCategory>Structure</designationCategory>
		<researchPrerequisites>
			<li>Autodoors</li>
			<li>GDIResearch_Buildings</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>1000</WorkToBuild>
			<MaxHitPoints>750</MaxHitPoints>
			<Flammability>0.0</Flammability>
		</statBases>
		<damageMultipliers>
		<li>
			<damageDef>TRSound</damageDef>
			<multiplier>0.5</multiplier>
		</li>
		</damageMultipliers>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
	</ThingDef>	

	<ThingDef ParentName="BuildingBase" Name="GDIWall">
		<defName>GDIWall</defName>
		<label>GDI wall</label>
		<thingClass>Building</thingClass>
		<category>Building</category>
		<description>An impassable wall, reinforced by GDI engineers.</description>
		<graphicData>
			<texPath>Building/GDI/Defense/Wall_GDI</texPath>
			<graphicClass>Graphic_single</graphicClass>
			<linkType>CornerFiller</linkType>
			<linkFlags>
				<li>Wall</li>
				<li>Rock</li>
			</linkFlags>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
				<edgeTop>Damage/Edge</edgeTop>
				<edgeBot>Damage/Edge</edgeBot>
				<edgeLeft>Damage/Edge</edgeLeft>
				<edgeRight>Damage/Edge</edgeRight>
			</damageData>
		</graphicData>
		<costList>
			<GDI_ReinforcedPlate>3</GDI_ReinforcedPlate>
		</costList>
		<uiIconPath>Building/GDI/Defense/Wall_GDI_Icon</uiIconPath>
		<statBases>
			<MaxHitPoints>1000</MaxHitPoints>
			<WorkToBuild>1000</WorkToBuild>
			<Flammability>0.0</Flammability>
		</statBases>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<fillPercent>1</fillPercent>
		<coversFloor>true</coversFloor>
		<placingDraggableDimensions>1</placingDraggableDimensions>
		<tickerType>Never</tickerType>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<holdsRoof>true</holdsRoof>
		<designationCategory>Structure</designationCategory>
		<staticSunShadowHeight>1.0</staticSunShadowHeight>
		<blockLight>true</blockLight>
		<canOverlapZones>false</canOverlapZones>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<blueprintGraphicData>
				<texPath>Building/GDI/Defense/Wall_GDI</texPath>
			</blueprintGraphicData>
		</building>
		<damageMultipliers>
		<li>
			<damageDef>Bomb</damageDef>
			<multiplier>2</multiplier>
		</li>
		<li>
			<damageDef>TRSound</damageDef>
			<multiplier>0</multiplier>
		</li>
		</damageMultipliers>
		<researchPrerequisites><li>GDIResearch_Buildings</li></researchPrerequisites>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
	</ThingDef>

