<Defs>

	<ThingDef ParentName="ResourceBase">
		<defName>GDI_ReinforcedPlate</defName>
		<label>Reinforced Plate</label>
		<description>This material is used in many GDI constructions. This alloy is resistant to most influences.</description>
		<graphicData>
			<texPath>Items/ReinforcedPlate</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<techLevel>Industrial</techLevel>
		<stackLimit>100</stackLimit>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<MarketValue>15</MarketValue>
			<Mass>0.75</Mass>
			<Flammability>0.25</Flammability>
			<DeteriorationRate>0.75</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>Nod_CarbonPlate</defName>
		<label>Carbon Plate</label>
		<description>Nod's engineers have been trying to figure out a material that is strong enough to sustain any direct attack. After years of development this new carbon based material was born.</description>
		<graphicData>
			<texPath>Items/CarbonPlate</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<techLevel>Industrial</techLevel>
		<stackLimit>100</stackLimit>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<MarketValue>15</MarketValue>
			<Mass>0.4</Mass>
			<Flammability>0.75</Flammability>
			<DeteriorationRate>0.75</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
	</ThingDef>
	
