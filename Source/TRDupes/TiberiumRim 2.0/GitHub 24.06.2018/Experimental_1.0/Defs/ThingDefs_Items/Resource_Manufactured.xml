	<ThingDef ParentName="ResourceBase">
		<defName>TRBattleChip</defName>
		<label>Automation Core</label>
		<description>This material is can use to be build the advanced Mechanoids or defense turrets.\n\nOnly can be get through battle.</description>
		<graphicData>
			<texPath>Items/BattleChip</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>25</stackLimit>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<MarketValue>250</MarketValue>
			<Mass>0.75</Mass>
			<Flammability>0.05</Flammability>
			<DeteriorationRate>0.75</DeteriorationRate>
		</statBases>
		<tradeability>Sellable</tradeability>
		<tradeTags>
			<li>Exotic</li>
		</tradeTags>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>JuggernautShell_Explosive</defName>
		<label>Juggernaut shells (explosive)</label>
		<description>A pack of shells to be fired by a Juggernaut Turret, these three shells will explode on contact.</description>
		<graphicData>
		<texPath>Items/Juggernaut_Shell</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>30</stackLimit>
		<tickerType>Normal</tickerType>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MarketValue>2000</MarketValue>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>5</Mass>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>1.5</DeteriorationRate>
		</statBases>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>4.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<explosiveExpandPerStackcount>0.3</explosiveExpandPerStackcount>
				<startWickHitPointsPercent>0.2</startWickHitPointsPercent>
				<explosionEffect>GiantExplosion</explosionEffect>
				<explosionSound>Explosion_GiantBomb</explosionSound>
				<wickTicks>
					<min>10</min>
					<max>30</max>
				</wickTicks>
			</li>
		</comps>
		<projectileWhenLoaded>Bullet_JuggernautBomb</projectileWhenLoaded>
		<recipeMaker>
			<workSpeedStat>SmithingSpeed</workSpeedStat>
			<effectWorking>Cook</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<workAmount>800</workAmount>
			<targetCountAdjustment>5</targetCountAdjustment>
			<workSkill>Crafting</workSkill>
			<recipeUsers>
				<li>GDI_Factory</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<researchPrerequisite>GDIResearch_AdvancedSecurity</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Shell_HighExplosive>1</Shell_HighExplosive>
			<GDI_ReinforcedPlate>5</GDI_ReinforcedPlate>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<thingCategories>
			<li>JuggernautShells</li>
		</thingCategories>		
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>TempleShell_Explosive</defName>
		<label>tactical nuclear shell</label>
		<description>A tactical nuclear missile to be fired by a Nod temple, these shells will big chain explode on contact.</description>
		<graphicData>
			<texPath>Items/Temple_Shell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>2</drawSize>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>1</stackLimit>
		<tickerType>Normal</tickerType>
		<techLevel>Industrial</techLevel>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>6</explosiveRadius>
				<damageAmountBase>500</damageAmountBase>
				<explosiveDamageType>TRNuke</explosiveDamageType>
				<postExplosionSpawnThingDef>Gas_Tiberium</postExplosionSpawnThingDef>
				<postExplosionSpawnChance>0.25</postExplosionSpawnChance>
				<explosionEffect>GiantExplosion</explosionEffect>
				<wickTicks>
					<min>10</min>
					<max>30</max>
				</wickTicks>
			</li>
		</comps>
		<statBases>
			<MarketValue>15000</MarketValue>
			<MaxHitPoints>50</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Mass>25</Mass>
			<Beauty>-50</Beauty>
			<DeteriorationRate>1.5</DeteriorationRate>
		</statBases>
		<projectileWhenLoaded>Bullet_TempleBomb</projectileWhenLoaded>
		<recipeMaker> 
			<workSpeedStat>SmithingSpeed</workSpeedStat>
			<effectWorking>Cook</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<workAmount>30000</workAmount>
			<workSkill>Crafting</workSkill>
			<recipeUsers>
				<li>Nod_Factory</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
			<researchPrerequisite>NodResearch_Temple</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Shell_HighExplosive>5</Shell_HighExplosive>
			<Nod_LQTiberiumCore>3</Nod_LQTiberiumCore>
			<Uranium>5</Uranium>
		</costList>
		<thingCategories>
			<li>TempleShells</li>
		</thingCategories>		
	</ThingDef>
	
	<ThingCategoryDef>
		<defName>TempleShells</defName>
		<label>nuclear shells</label>
		<parent>Manufactured</parent>
		<iconPath>UI/Icons/ThingCategories/MortarShells</iconPath>
	</ThingCategoryDef>
	
