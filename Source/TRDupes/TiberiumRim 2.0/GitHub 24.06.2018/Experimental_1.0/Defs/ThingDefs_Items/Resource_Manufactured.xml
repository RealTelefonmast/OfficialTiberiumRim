	<ThingDef ParentName="ResourceBase">
		<defName>Nod_LQTiberiumCore</defName>
		<label>Liquid Tiberium Core (explosive)</label>
		<description>Due to it's unstable nature, liquid Tiberium cannot be handled directly and needs to be stabilized. This component manages to do so.</description>
		<graphicData>
			<texPath>Items/Core_TiberiumLQ</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>25</stackLimit>
		<statBases>
			<MaxHitPoints>175</MaxHitPoints>
			<MarketValue>2500</MarketValue>
			<Mass>5</Mass>
			<Flammability>1</Flammability>
			<DeteriorationRate>0.90</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>2</explosiveRadius>
				<explosiveDamageType>TRTiberiumBomb</explosiveDamageType>
				<explosiveExpandPerStackcount>0.2</explosiveExpandPerStackcount>
				<startWickHitPointsPercent>0.1</startWickHitPointsPercent>
				<wickTicks>
					<min>5</min>
					<max>5</max>
				</wickTicks>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ResourceBase">
		<defName>GDI_SonicCore</defName>
		<label>Sonic Energy Core (explosive)</label>
		<description>Sonic technology is extremly experimental and needs special measures to be handled. This component serves as a core part in most sonic weaponry.</description>
		<graphicData>
			<texPath>Items/Core_Sonic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<stackLimit>25</stackLimit>
		<statBases>
			<MaxHitPoints>175</MaxHitPoints>
			<MarketValue>2500</MarketValue>
			<Mass>0.4</Mass>
			<Flammability>0.75</Flammability>
			<DeteriorationRate>0.90</DeteriorationRate>
		</statBases>
		<intricate>true</intricate>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>2</explosiveRadius>
				<explosiveDamageType>TRSound</explosiveDamageType>
				<explosiveExpandPerStackcount>0.1</explosiveExpandPerStackcount>
				<startWickHitPointsPercent>0.05</startWickHitPointsPercent>
				<wickTicks>
					<min>5</min>
					<max>5</max>
				</wickTicks>
			</li>
		</comps>
	</ThingDef>
	
