		<label>shock disc</label>
		<description>shock disc</description>
		<graphicData>
			<texPath>Equipments/Weapons/Projectile/Bullet_Disc</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
