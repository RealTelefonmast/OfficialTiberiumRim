		</verbs>
		<comps>
		  <li>
		    <compClass>CompOversizedWeapon.CompOversizedWeapon</compClass>
		  </li>
		</comps>
	</ThingDef>	

	<ThingDef Class="JecsTools.ThingDef_LaserProjectile" ParentName="BaseBullet">
