			<texPath>Equipments/Apparels/Nod_Militia/MilitiaSuitMask</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
		</graphicData>
		<costList>
			<Cloth>50</Cloth>
			<Nod_CarbonPlate>5</Nod_CarbonPlate>
		</costList>
		<statBases>
			<MarketValue>600</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToMake>6000</WorkToMake>
			<Mass>0.5</Mass>
