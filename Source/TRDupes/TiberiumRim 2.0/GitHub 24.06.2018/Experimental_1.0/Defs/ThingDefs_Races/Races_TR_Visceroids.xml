	<ThingDef ParentName="TiberiumLifeform">
		<defName>Visceroid_TBI</defName>
		<label>Visceroid</label>
		<thingClass>TiberiumRim.Visceroid</thingClass>
		<description>A blob-like and disturbing lifeform. Formed after the death of a creature by Tiberium.</description>
			<statBases>
			<MoveSpeed>2</MoveSpeed>
			<MarketValue>100</MarketValue>
		</statBases>
		<tools>
			<li>
				<label>Tentacles</label>
				<capacities>
					<li>Blunt</li>
					<li>Stab</li>
				</capacities>
				<power>15</power>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>VisTentacles</linkedBodyPartsGroup>
			</li>
			<li>
				<label>gasy</label>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>20</power>
				<cooldownTime>3</cooldownTime>
				<linkedBodyPartsGroup>VisGash</linkedBodyPartsGroup>
			</li>
		</tools>
		<race>
			<body>Visceroid</body>
			<thinkTreeConstant>Visceroid_Constant</thinkTreeConstant>
			<maxPreyBodySize>1.5</maxPreyBodySize>
			<baseBodySize>1.2</baseBodySize>
			<baseHungerRate>0.4</baseHungerRate>
			<baseHealthScale>0.5</baseHealthScale>
			<lifeStageAges>
					<li>
						<def>AnimalAdult</def>
						<minAge>0</minAge>
						<!-- Keeping the Cobra sounds because it fits the Visceroid.-->
						<soundWounded>Pawn_Cobra_Wounded</soundWounded>
						<soundDeath>Pawn_Cobra_Death</soundDeath>
						<soundCall>Pawn_Cobra_Call</soundCall>
						<soundAngry>Pawn_Cobra_Angry</soundAngry>
					</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
		<tradeTags>
		  <li>BadassAnimal</li>
		</tradeTags>
	</ThingDef> 
  
