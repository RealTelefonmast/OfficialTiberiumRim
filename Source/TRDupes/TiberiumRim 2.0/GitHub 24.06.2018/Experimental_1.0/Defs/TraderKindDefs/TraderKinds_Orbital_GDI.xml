		<li Class="StockGenerator_Category">
			<categoryDef>Manufactured</categoryDef>
			<thingDefCountRange>
				<min>1</min>
				<max>6</max>
			</thingDefCountRange>
			<totalPriceRange>
				<min>800</min>
				<max>1500</max>
			</totalPriceRange>
		</li>
		-->
		<li Class="StockGenerator_BuyExpensiveSimple" />
	</stockGenerators>
