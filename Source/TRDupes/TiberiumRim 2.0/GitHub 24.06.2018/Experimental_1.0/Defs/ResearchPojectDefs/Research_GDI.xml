<!--tier3-->
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_AdvancedSecurity</defName>
		<label>Advanced GDI Security</label>
		<description>Get access to advanced GDI security structures. Unlocks sonic weaponry.</description>
		<baseCost>3500</baseCost>
		<prerequisites>
			<li>GDIResearch_Security</li>
			<li>GDIResearch_AdvancedTechnology</li>
		</prerequisites>
		<requiredResearchFacilities>
			<li>GDI_Armory</li>
		</requiredResearchFacilities>
		<researchViewX>7</researchViewX>
		<researchViewY>0</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_SonicTechnology</defName>
		<label>Sonic Breakthrough</label>
		<description>GDI has developed new means in fighting Tiberium. These new weaponized sonic technologies can be used in warfare aswell. Unlocks the advanced sonic inhibitor, mobile sonic shatterer weapon and sonic emitter security stucture.</description>
		<baseCost>4000</baseCost>
		<prerequisites>
			<li>GDIResearch_AdvancedTechnology</li>
		</prerequisites>
		<requiredResearchFacilities>
			<li>GDI_Armory</li>
		</requiredResearchFacilities>		
		<researchViewX>7</researchViewX>
		<researchViewY>0.75</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_AdvancedProduction</defName>
		<label>GDI Armory II</label>
		<description>Get access to GDI's advanced and experimental weapons. Unlocks the Zone Trooper armor and railgun.</description>
		<baseCost>3500</baseCost>
		<prerequisites>
			<!--<li>GDIResearch_TiberiumDrugs</li>-->
			<li>GDIResearch_AdvancedTechnology</li>
		</prerequisites>
		<requiredResearchFacilities>
			<li>GDI_Armory</li>
		</requiredResearchFacilities>		
		<researchViewX>7</researchViewX>
		<researchViewY>1.5</researchViewY>
	</ResearchProjectDef>
	
