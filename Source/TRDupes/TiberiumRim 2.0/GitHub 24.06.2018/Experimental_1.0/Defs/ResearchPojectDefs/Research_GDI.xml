<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--tier0-->
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch</defName>
		<label>GDI</label>		
		<description>Join the Global Defense Initiative. And become the enemy of the Brotherhood.</description>
		<baseCost>500</baseCost>		
		<prerequisites>
			<li>CommandandConquer</li>
		</prerequisites>		
		<researchViewX>4</researchViewX>
		<researchViewY>0.75</researchViewY>
	</ResearchProjectDef>

<!--tier1-->
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_Buildings</defName>
		<label>GDI Structures</label>
		<description>Get access to GDI structures. Unlocks basic structures and production facilities.</description>
		<baseCost>1500</baseCost>		
		<prerequisites>
			<li>GDIResearch_Technology</li>
		</prerequisites>		
		<researchViewX>5</researchViewX>
		<researchViewY>0</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_Technology</defName>
		<label>GDI Intel</label>
		<description>Get access to information only known by GDI commanders. Necessary for basic technologies.</description>
		<baseCost>2000</baseCost>
		<prerequisites>
			<li>GDIResearch</li>
		</prerequisites>
		<researchViewX>5</researchViewX>
		<researchViewY>0.75</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_Production</defName>
		<label>GDI Armory I</label>
		<description>Get access to GDI's Armory and protect the world. Unlocks small firearms and armor suits.</description>
		<baseCost>1500</baseCost>
		<prerequisites>
			<li>GDIResearch_Technology</li>
		</prerequisites>
		<researchViewX>5</researchViewX>
		<researchViewY>1.5</researchViewY>
	</ResearchProjectDef>
	
<!--tier2-->
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_Security</defName>
		<label>Defensive Structures</label>
		<description>Get access to basic GDI security structures. Unlocks the guardian turret.</description>
		<baseCost>2500</baseCost>
		<prerequisites>
			<li>GDIResearch_Buildings</li>
			<li>GunTurrets</li>
		</prerequisites>
		<researchViewX>6</researchViewX>
		<researchViewY>0</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef ParentName="TRProject">
		<defName>GDIResearch_AdvancedTechnology</defName>
		<label>Classified Information</label>
		<description>Get access to classified information only known by high ranking personell. Necessary for advanced technologies.</description>
		<baseCost>3000</baseCost>
		<prerequisites>
			<li>GDIResearch_Technology</li>
		</prerequisites>		
		<researchViewX>6</researchViewX>
		<researchViewY>0.75</researchViewY>
	</ResearchProjectDef>
