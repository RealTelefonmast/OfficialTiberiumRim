			</li>
		</comps>
		<researchPrerequisites><li>NodResearch_AdvancedTechnology</li></researchPrerequisites>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
	</ThingDef>

	
