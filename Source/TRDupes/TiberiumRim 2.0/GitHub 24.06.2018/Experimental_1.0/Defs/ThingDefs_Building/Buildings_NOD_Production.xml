	<ThingDef ParentName="BuildingBase">
		<defName>Nod_TiberiumPowerPlant</defName>
		<label>Nod Powerplant</label>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Building/Nod/Production/Powerplant_Nod</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>8000</MarketValue>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>4000</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>Produces power by consuming Tiberium fuel. Must be fueled by hand.</description>
		<size>(4,4)</size>
		<costList>
			<Nod_CarbonPlate>20</Nod_CarbonPlate>
			<Uranium>40</Uranium>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3</explosiveRadius>
				<explosiveDamageType>TRTiberiumBomb</explosiveDamageType>
				<preExplosionSpawnThingDef>Gas_Tiberium</preExplosionSpawnThingDef>
				<preExplosionSpawnChance>0.25</preExplosionSpawnChance>
				<postExplosionSpawnThingDef>FilthTibLiquidGreen</postExplosionSpawnThingDef>
				<postExplosionSpawnChance>0.5</postExplosionSpawnChance>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>5</glowRadius>
				<glowColor>(255,150,150)</glowColor>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerPlant</compClass>
				<basePowerConsumption>-4000</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable" />

			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>0.8</fuelConsumptionRate>
				<fuelCapacity>20.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
			</li>			
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>100</heatPerSecond>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<staticSunShadowHeight>0.5</staticSunShadowHeight>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites><li>NodResearch_Buildings</li></researchPrerequisites>
		<filthLeaving>FilthTibLiquidGreen</filthLeaving>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>
	
