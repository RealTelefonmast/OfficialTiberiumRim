	<ThingDef ParentName="BuildingBase">
		<defName>GDI_TiberiumPowerPlant</defName>
		<label>GDI Powerplant</label>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Building/GDI/Primary/Powerplant_GDI</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>10000</MarketValue>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>Produces power by consuming Tiberium fuel. Must be fueled by hand.</description>
		<size>(4,4)</size>
		<costList>
			<GDI_ReinforcedPlate>20</GDI_ReinforcedPlate>
			<Uranium>50</Uranium>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3</explosiveRadius>
				<explosiveDamageType>TRTiberiumBomb</explosiveDamageType>
				<preExplosionSpawnThingDef>Gas_Tiberium</preExplosionSpawnThingDef>
				<preExplosionSpawnChance>0.25</preExplosionSpawnChance>
				<postExplosionSpawnThingDef>FilthTibLiquidGreen</postExplosionSpawnThingDef>
				<postExplosionSpawnChance>0.5</postExplosionSpawnChance>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerPlant</compClass>
				<basePowerConsumption>-5000</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable" />

			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>1</fuelConsumptionRate>
				<fuelCapacity>25.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>5</glowRadius>
				<glowColor>(200,200,255)</glowColor>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>100</heatPerSecond>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<staticSunShadowHeight>0.5</staticSunShadowHeight>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites><li>GDIResearch_Buildings</li></researchPrerequisites>
		<filthLeaving>FilthTibLiquidGreen</filthLeaving>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>
	
</Defs>