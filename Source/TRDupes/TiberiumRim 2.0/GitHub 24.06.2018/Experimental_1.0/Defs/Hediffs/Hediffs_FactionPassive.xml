<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>TiberiumInfusionImmunityNPC</defName>
		<label>Tiberium vaccine effect</label>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.5, 1)</defaultLabelColor>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>
					<min>150000</min>
					<max>250000</max>
				</disappearsAfterTicks>
			</li>
		  <!--<li Class="TiberiumRim.HediffCompProperties_TiberiumInfusionImmunity" />-->
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>TiberiumMutationGoodNPC</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(200, 200, 100)</defaultLabelColor>
		<label>Tiberium Mutation (Good)</label>
		<comps>
		  <li Class="HediffCompProperties_VerbGiver">
			<verbs>
			  <li>
				<verbClass>Verb_MeleeAttack</verbClass>
				<defaultCooldownTime>1.65</defaultCooldownTime>
				<meleeDamageBaseAmount>12</meleeDamageBaseAmount>
				<meleeDamageDef>Scratch</meleeDamageDef>
			  </li>
			</verbs>
		  </li>
		  <!--<li Class="TiberiumRim.HediffCompProperties_TiberiumInfusionImmunity" />-->
		</comps>
		<stages>
		  <li>
			  <painFactor>0.75</painFactor>
			  <capMods>
				<li>
					<capacity>Sight</capacity>
					<offset>0.1</offset>
				</li>
				<li>
					<capacity>Moving</capacity>
					<offset>0.1</offset>
				</li>
				<li>
					<capacity>BloodFiltration</capacity>
					<offset>0.25</offset>
				</li>
				<li>
					<capacity>Breathing</capacity>
					<offset>0.25</offset>
				</li>
			  </capMods>
		  </li>
		</stages>
	</HediffDef>
	
	<HediffDef>
		<defName>TiberiumMutationBadNPC</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(150, 150, 75)</defaultLabelColor>
		<label>Tiberium Mutation (Bad)</label>
		<comps>
			<!--<li Class="TiberiumRim.HediffCompProperties_TiberiumInfusionImmunity" />-->
		</comps>
		<stages>
		  <li>
			<painOffset>0.1</painOffset>
			  <capMods>
				<li>
				  <capacity>Manipulation</capacity>
				  <offset>-0.1</offset>
				</li>
				<li>
					<capacity>Moving</capacity>
					<offset>-0.1</offset>
				</li>
				<li>
					<capacity>Sight</capacity>
					<offset>-0.25</offset>
				</li>
				<li>
					<capacity>BloodFiltration</capacity>
					<offset>-0.1</offset>
				</li>
				<li>
					<capacity>Breathing</capacity>
					<offset>-0.1</offset>
				</li>
			  </capMods>
		  </li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>FeelNoPainMechNPC</defName>
		<label>Mechanic unit</label>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255, 255, 150)</defaultLabelColor>
		<isBad>false</isBad>
